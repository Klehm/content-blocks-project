{
    "name": "klehm/content-blocks-monorepo",
    "description": "Monorepo ContentBlocks — Page builder modulaire pour Symfony",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/content-blocks",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/content-blocks-kit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "packages/content-blocks-i18n",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.2",
        "klehm/content-blocks": "@dev",
        "klehm/content-blocks-kit": "@dev",
        "klehm/content-blocks-i18n": "@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-doctrine": "^2.0",
        "symfony/asset": "^6.4 || ^7.0 || ^8.0"
    }
}
