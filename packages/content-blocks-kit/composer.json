{
    "name": "klehm/content-blocks-kit",
    "description": "Nineteen ready-to-use, self-contained block types for ContentBlocks (title, text, rich text, image, gallery, button, card, tabs, video…).",
    "keywords": [
        "blocks",
        "content-blocks",
        "page-builder",
        "symfony",
        "symfony-bundle",
        "symfony-ux"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/klehm/content-blocks-project",
    "support": {
        "issues": "https://github.com/klehm/content-blocks-project/issues",
        "source": "https://github.com/klehm/content-blocks-kit"
    },
    "authors": [
        {
            "name": "Clément Muller",
            "email": "klehm.muller@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "klehm/content-blocks": "^1.0.0-RC17",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/html-sanitizer": "^6.4 || ^7.0 || ^8.0",
        "symfony/options-resolver": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "symfony/ux-live-component": "^2.36 || ^3.0",
        "symfony/validator": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/asset": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "ContentBlocks\\Kit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentBlocks\\Kit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "ContentBlocks\\Kit\\ContentBlocksKitBundle"
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev",
            "dev-main": "1.0.x-dev"
        }
    },
    "repositories": {
        "core": {
            "type": "path",
            "url": "../content-blocks"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
