{
    "name": "@klehm/content-blocks-kit",
    "description": "Default blocks for ContentBlocks (Text, Title, Image, Tabs).",
    "license": "MIT",
    "symfony": {
        "controllers": {
            "cb-tinymce": {
                "main": "controllers/cb-tinymce_controller.js",
                "name": "cb-tinymce",
                "fetch": "lazy",
                "enabled": true
            },
            "cb-ckeditor": {
                "main": "controllers/cb-ckeditor_controller.js",
                "name": "cb-ckeditor",
                "fetch": "lazy",
                "enabled": true
            },
            "cb-gallery": {
                "main": "controllers/cb-gallery_controller.js",
                "name": "cb-gallery",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0"
    }
}
