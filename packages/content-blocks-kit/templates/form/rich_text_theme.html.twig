{# Knows nothing about any editor: the adapter hands over a controller name
   and encoded values. See docs/internals/kit.md #}

{# `use`, not `extends`: theme stacking decides which theme answers a form
   block, but `block()` is a plain lookup against this template alone. #}
{% use '@ContentBlocks/form/cb_form_theme.html.twig' %}

{% block cb_rich_text_widget -%}
    {%- set editor = cb_editor -%}
    {# The Stimulus target is named after the controller, so the same markup
       serves every adapter without the theme knowing any of them. #}
    {%- set attr = attr|merge({('data-' ~ editor.controller ~ '-target'): 'textarea'}) -%}
    <div data-controller="{{ editor.controller }}" data-live-ignore
        {%- for name, value in editor.values %} data-{{ editor.controller }}-{{ name }}-value="{{ value }}"{% endfor %}>
        {{ block('textarea_widget') }}
    </div>
{%- endblock cb_rich_text_widget %}
