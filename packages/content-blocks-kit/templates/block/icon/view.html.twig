{# IconBlock view — renders a glyph from the resolved IconRegistry (kit-authored
   or host-contributed SVG, safe raw). `color` is a plain #hex ('' → currentColor);
   size is px. `align` is a class suffix and passes through, configured values
   included. #}
{% set name = data.name|default('star') %}
{% set svg = cb_kit_icon(name, data.size|default(48)|abs) %}

{# A name no provider supplies would otherwise render the block as *nothing* —
   the one choice field in the kit whose unknown value costs the whole block
   rather than a fallback. It happens with stored data older than an icon set,
   or a `choices` map naming a glyph that was never contributed. Icons are added
   through IconProviderInterface, not through `choices`; see that interface. #}
{% if svg is empty %}
    {% set svg = cb_kit_icon('star', data.size|default(48)|abs) %}
{% endif %}

{% if svg is not empty %}
    {% set align = cb_kit_token(data.align|default('center'), 'center') %}
    {% set color = data.color|default('') %}
    <div class="cb-kit-icon cb-kit-icon--{{ align }}"
         {%- if color is not empty %} style="color: {{ color|e('html_attr') }}"{% endif %}>
        {{ svg|raw }}
    </div>
{% endif %}
