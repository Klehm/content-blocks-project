{# TitleBlock view — the semantic element (tag) and the visual size are
   independent: a <h2> can be rendered at h1 size via cb-kit-title--h*. #}
{% if data.text|default %}
    {# The one kit choice NOT passed through: it becomes the element name,
       so the list stays closed whatever `choices` says. #}
    {% set tag = data.tag|default('h2') %}
    {% set tag = tag in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p'] ? tag : 'h2' %}

    {# Blocks saved before the size field follow their tag, so their visual
       scale is preserved. Resolved before the passthrough. #}
    {% set size = data.size|default(tag in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'h2') %}

    {# The size only suffixes a class, so a config-added value renders and
       the host writes the rule. #}
    {% set size = cb_kit_token(size, 'h2') %}

    {# Optional palette color; '' inherits. #}
    {% set color = data.color|default('') %}
    <{{ tag }} class="cb-kit-title cb-kit-title--{{ size }}"{% if color is not empty %} style="color: {{ color|e('html_attr') }}"{% endif %}>{{ data.text }}</{{ tag }}>
{% else %}
    <small style="color: #5b6478;">{{ 'cb_kit.block.title.empty'|trans({}, 'content_blocks_kit') }}</small>
{% endif %}
