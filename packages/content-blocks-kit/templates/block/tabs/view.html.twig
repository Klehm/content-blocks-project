{# TabsBlock — CSS-only tabs (no JS dependency).

   A radio per tab, its label right after it, its panel right after the label.
   Flex ordering puts every label on the first row and every panel below, so
   the active state is two static rules in kit.css (`:checked + label`,
   `:checked + label + panel`) — no per-tab rule, no id selector, and no
   inline <style>. The ids below only pair a label with its input; nothing
   styles them, so a host retheming the block never fights their specificity.
#}
{% if data.items is defined and data.items is iterable and data.items|length > 0 %}
    {% set uid = 'cb-kit-tabs-' ~ random() %}
    <div class="cb-kit-tabs">
        {% for tab in data.items %}
            {# Native radios, kept focusable (offscreen, not `display:none`):
               a radio group already gives arrow-key navigation for free, and
               the visible focus ring is drawn on the label next to it. #}
            <input type="radio"
                   name="{{ uid }}"
                   id="{{ uid }}-{{ loop.index0 }}"
                   class="cb-kit-tabs__radio"
                   aria-controls="{{ uid }}-{{ loop.index0 }}-panel"
                   {% if loop.first %}checked{% endif %}>
            <label for="{{ uid }}-{{ loop.index0 }}"
                   id="{{ uid }}-{{ loop.index0 }}-label"
                   class="cb-kit-tabs__tab">{{ tab.title|default('Untitled') }}</label>
            {# `region` + aria-labelledby rather than a half-built tab/tablist
               set: the panel is honestly a labelled region, and the radios
               keep their native semantics. #}
            <div class="cb-kit-tabs__panel"
                 id="{{ uid }}-{{ loop.index0 }}-panel"
                 role="region"
                 aria-labelledby="{{ uid }}-{{ loop.index0 }}-label">
                {{ tab.content|default('')|nl2br }}
            </div>
        {% endfor %}
    </div>
{% else %}
    <small class="cb-kit-tabs__empty">{{ 'cb_kit.block.tabs.empty'|trans({}, 'content_blocks_kit') }}</small>
{% endif %}
