{# ListBlock view. Style: bullet | check | numbered. #}
{% set items = data.items|default([])|map(i => i.text|default(''))|filter(t => t|trim is not empty) %}
{% if items|length > 0 %}
    {% set style = data.style|default('bullet') %}
    {% set style = style in ['bullet', 'check', 'numbered'] ? style : 'bullet' %}
    {% set tag = style == 'numbered' ? 'ol' : 'ul' %}
    <{{ tag }} class="cb-kit-list cb-kit-list--{{ style }}">
        {% for text in items %}
            <li class="cb-kit-list__item">
                {% if style == 'check' %}<span class="cb-kit-list__check" aria-hidden="true">{{ cb_kit_icon('check', 18)|raw }}</span>{% endif %}
                <span>{{ text }}</span>
            </li>
        {% endfor %}
    </{{ tag }}>
{% endif %}
