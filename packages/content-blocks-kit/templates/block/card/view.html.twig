{# CardBlock view — grid (N columns) or stacked list. #}
{% set items = data.items|default([]) %}
{% if items|length > 0 %}
    {# Passed through to the class so a layout added via config can be styled.
       The column count is only emitted for the coded `grid` layout, which is
       the one whose CSS reads --cb-kit-cols; a host's own layout declares
       whatever it needs in its own rules. #}
    {% set layout = cb_kit_token(data.layout|default('grid'), 'grid') %}
    {# Cast, for the same reason as gallery: it lands in a style attribute. #}
    {% set columns = data.columns|default(3)|abs %}
    <div class="cb-kit-cards cb-kit-cards--{{ layout }}"{% if layout == 'grid' %} style="--cb-kit-cols:{{ columns }}"{% endif %}>
        {% for item in items %}
            <article class="cb-kit-card">
                {% if item.src|default('')|trim is not empty %}
                    {# Card media is fluid (the grid decides its width), so the
                       resolver gets the source alone and owns `sizes` if it
                       returns candidates. #}
                    {% set img = cb_image(item.src) %}
                    <div class="cb-kit-card__media"><img src="{{ img.src }}" alt="{{ item.title|default('') }}"
                        {%- if img.srcset %} srcset="{{ img.srcset }}"{% endif %}{% if img.sizes %} sizes="{{ img.sizes }}"{% endif %} loading="lazy" decoding="async"></div>
                {% endif %}
                <div class="cb-kit-card__body">
                    {% if item.title|default('')|trim is not empty %}<h3 class="cb-kit-card__title">{{ item.title }}</h3>{% endif %}
                    {% if item.content|default('')|trim is not empty %}<div class="cb-kit-card__text">{{ item.content|nl2br }}</div>{% endif %}
                    {% if item.url|default('')|trim is not empty and item.buttonText|default('')|trim is not empty %}
                        <a class="cb-kit-btn cb-kit-btn--primary cb-kit-btn--sm cb-kit-card__btn" href="{{ item.url }}">{{ item.buttonText }}</a>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </div>
{% endif %}
