{# ButtonBlock view. Neutral cb-kit-* classes styled by kit.css.

   variant / size / align are pure class suffixes, so they are passed through
   as-is: a value a host added via `content_blocks_kit.blocks.button.choices`
   reaches the markup, and the matching CSS is the host's to write.
   `cb_kit_token()` only guards the *shape* of the value — see its extension. #}
{% set text = data.text|default('')|trim %}
{% if text is not empty %}
    {% set align = cb_kit_token(data.align|default('start'), 'start') %}
    {% set variant = cb_kit_token(data.variant|default('primary'), 'primary') %}
    {% set size = cb_kit_token(data.size|default('md'), 'md') %}
    <div class="cb-kit-btn-wrap cb-kit-btn-wrap--{{ align }}">
        <a class="cb-kit-btn cb-kit-btn--{{ variant }} cb-kit-btn--{{ size }}{{ data.fullWidth|default(false) ? ' cb-kit-btn--block' : '' }}"
           href="{{ data.url|default('#') }}"
           {%- if data.newTab|default(false) %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ text }}</a>
    </div>
{% endif %}
