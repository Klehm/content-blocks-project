{# Renders the editor's HTML as-is: the toolbar constrains what is written,
   but the stored value is not sanitized server-side. #}
{% if data.content|default %}
    <div class="cb-block-rich-text">{{ data.content|raw }}</div>
{% else %}
    <small style="color: #5b6478;">{{ 'cb_kit.block.rich_text.empty'|trans({}, 'content_blocks_kit') }}</small>
{% endif %}
