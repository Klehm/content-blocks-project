{# ImageBlock view — plain <img> sized by a preset / custom width+height, with
   object-fit, alignment, an optional link and caption, and per-corner radius.
   No image-processing dependency: the stored src goes through the core's
   `cb_image()` seam, whose default resolver returns it untouched; only the
   *display* box is controlled here. A host that aliases
   ImageUrlResolverInterface gets srcset/sizes out of the same markup. #}
{% set src = data.src|default('')|trim %}
{% if src is not empty %}
    {% set size = data.size|default('md') %}
    {% set align = cb_kit_token(data.align|default('center'), 'center') %}

    {# Target display width. Presets are fixed; 'custom' reads the field;
       'full' → fluid (max-width:100%). A size a host added through config has
       no preset entry, so it lands on the same fluid path as 'full' — the only
       honest answer, since only this template knows what a pixel width means. #}
    {% set preset_width = { sm: 400, md: 800, lg: 1200 }[size]|default(null) %}
    {% set width = size == 'custom' ? (data.customWidth|default(null)) : preset_width %}
    {% set width = width ? width|abs : null %}
    {% set height_auto = data.customHeightAuto ?? true %}
    {% set height = (size == 'custom' and not height_auto and data.customHeight|default(null)) ? data.customHeight|abs : null %}

    {# `fit` goes straight into `object-fit`, a CSS keyword — so a configured
       value (fill, none, scale-down) works with no CSS to write at all. #}
    {% set fit = cb_kit_token(data.fit|default('cover'), 'cover') %}

    {# Per-corner radius from BoxSpacingType {top,right,bottom,left}. #}
    {% set br = data.borderRadius|default({}) %}
    {% set has_radius = (br.top ?? null) is not null or (br.right ?? null) is not null or (br.bottom ?? null) is not null or (br.left ?? null) is not null %}
    {% set radius = has_radius ? (br.top ?? 0) ~ 'px ' ~ (br.right ?? 0) ~ 'px ' ~ (br.bottom ?? 0) ~ 'px ' ~ (br.left ?? 0) ~ 'px' : null %}

    {# Width caps the <img>, not the <figure>: the figure stays a full-width flex
       column so `align-items` (via cb-kit-image--{{ align }}) can place the image
       left/center/right. max-width:100% (kit.css) keeps it responsive. #}
    {% set img_style = (width ? 'width:' ~ width ~ 'px;' : '')
        ~ (height ? 'height:' ~ height ~ 'px;object-fit:' ~ fit ~ ';' : '')
        ~ (radius ? 'border-radius:' ~ radius ~ ';' : '') %}

    {# The display width/height computed above is exactly the input a resizing
       resolver needs. With none wired, `img` is the stored src and nothing else.
       When a resolver returns candidates but no `sizes`, derive one from the
       display width — an unqualified srcset would otherwise be read as 100vw,
       making the browser pick a wider file than the box it lands in. #}
    {% set img = cb_image(src, width, height) %}
    {% set sizes = img.sizes ?? (img.srcset and width ? '(max-width: ' ~ width ~ 'px) 100vw, ' ~ width ~ 'px' : null) %}

    {# The size also lands on a class. Without it a value a host added through
       config would be entirely inert here — it maps to no preset width, so the
       image goes fluid and nothing in the markup says which size was chosen.
       Additive: the coded sizes gain a class they did not have. #}
    <figure class="cb-kit-image cb-kit-image--{{ align }} cb-kit-image--size-{{ cb_kit_token(size, 'md') }}">
        {% if data.url|default('')|trim is not empty %}<a href="{{ data.url }}">{% endif %}
        <img class="cb-kit-image__img" src="{{ img.src }}" alt="{{ data.alt|default('') }}"
             {%- if img.srcset %} srcset="{{ img.srcset }}"{% endif %}{% if sizes %} sizes="{{ sizes }}"{% endif %}
             {%- if width %} width="{{ width }}"{% endif %}{% if height %} height="{{ height }}"{% endif %}
             {%- if img_style %} style="{{ img_style }}"{% endif %} loading="lazy" decoding="async">
        {% if data.url|default('')|trim is not empty %}</a>{% endif %}
        {% if data.caption|default('')|trim is not empty %}
            <figcaption class="cb-kit-image__caption">{{ data.caption }}</figcaption>
        {% endif %}
    </figure>
{% else %}
    <small class="cb-kit-muted">{{ 'cb_kit.block.image.no_image'|trans({}, 'content_blocks_kit') }}</small>
{% endif %}
