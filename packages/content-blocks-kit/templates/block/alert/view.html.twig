{# The type passes through as a class suffix, but the glyph map cannot
   follow — an added type has no entry, hence the explicit fallback. #}
{% set message = data.content|default('')|trim %}
{% if message is not empty %}
    {% set type = cb_kit_token(data.type|default('info'), 'info') %}
    {% set glyph = { info: 'info', success: 'check-circle', warning: 'warning', error: 'warning' }[type]|default('info') %}
    {% set title = data.title|default('')|trim %}
    <div class="cb-kit-alert cb-kit-alert--{{ type }}" role="note">
        <span class="cb-kit-alert__icon" aria-hidden="true">{{ cb_kit_icon(glyph, 20)|raw }}</span>
        <div class="cb-kit-alert__body">
            {% if title is not empty %}<p class="cb-kit-alert__title">{{ title }}</p>{% endif %}
            <p class="cb-kit-alert__message">{{ message|nl2br }}</p>
        </div>
    </div>
{% endif %}
