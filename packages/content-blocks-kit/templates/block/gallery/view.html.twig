{# GalleryBlock view — grid (N columns) or one-row slider. Sizing/fit/radius via
   CSS custom properties on the wrapper. #}
{% import _self as gallery %}
{% set items = data.items|default([])|filter(i => i.src|default('')|trim is not empty) %}
{% if items|length > 0 %}
    {# The slider branch stays keyed to the coded value, since it carries JS
       behaviour CSS cannot supply; anything else renders as a grid. #}
    {% set layout = cb_kit_token(data.layout|default('grid'), 'grid') %}
    {# Cast: the value is concatenated into a style attribute, and Block.data
       can arrive from an import that never met this block's validator. #}
    {% set columns = data.columns|default(3)|abs %}
    {% set fit = cb_kit_token(data.fit|default('cover'), 'cover') %}
    {% set br = data.borderRadius|default({}) %}
    {% set has_radius = (br.top ?? null) is not null or (br.right ?? null) is not null or (br.bottom ?? null) is not null or (br.left ?? null) is not null %}
    {% set vars = '--cb-kit-cols:' ~ columns ~ ';--cb-kit-fit:' ~ fit ~ ';'
        ~ (has_radius ? '--cb-kit-radius:' ~ (br.top ?? 0) ~ 'px ' ~ (br.right ?? 0) ~ 'px ' ~ (br.bottom ?? 0) ~ 'px ' ~ (br.left ?? 0) ~ 'px;' : '') %}

    {% if layout == 'slider' %}
        <div class="cb-kit-gallery cb-kit-gallery--slider" style="{{ vars }}" data-controller="cb-gallery">
            <button type="button" class="cb-kit-gallery__nav cb-kit-gallery__nav--prev" data-cb-gallery-target="prev" data-action="cb-gallery#prev" aria-label="Previous">{{ cb_kit_icon('arrow-right', 22)|raw }}</button>
            <div class="cb-kit-gallery__track" data-cb-gallery-target="track">
                {% for item in items %}{{ gallery.item(item, fit) }}{% endfor %}
            </div>
            <button type="button" class="cb-kit-gallery__nav cb-kit-gallery__nav--next" data-cb-gallery-target="next" data-action="cb-gallery#next" aria-label="Next">{{ cb_kit_icon('arrow-right', 22)|raw }}</button>
        </div>
    {% else %}
        <div class="cb-kit-gallery cb-kit-gallery--{{ layout }}" style="{{ vars }}">
            {% for item in items %}{{ gallery.item(item, fit) }}{% endfor %}
        </div>
    {% endif %}
{% endif %}

{% macro item(item, fit) %}
    {% set link = item.url|default('')|trim %}
    {# Nothing truthful to derive a `sizes` from, so the resolver owns it
       if it returns candidates at all. #}
    {% set img = cb_image(item.src) %}
    <figure class="cb-kit-gallery__item">
        {% if link is not empty %}<a href="{{ link }}">{% endif %}
        <img class="cb-kit-gallery__img" src="{{ img.src }}" alt="{{ item.alt|default('') }}"
             {%- if img.srcset %} srcset="{{ img.srcset }}"{% endif %}{% if img.sizes %} sizes="{{ img.sizes }}"{% endif %} loading="lazy" decoding="async">
        {% if link is not empty %}</a>{% endif %}
        {% if item.caption|default('')|trim is not empty %}
            <figcaption class="cb-kit-gallery__caption">{{ item.caption }}</figcaption>
        {% endif %}
    </figure>
{% endmacro %}
