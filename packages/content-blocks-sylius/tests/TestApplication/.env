# Read by sylius/test-application's bootstrap. Put local credentials in
# .env.test.local, next to this file (ignored by git).
DATABASE_URL=mysql://root@127.0.0.1/content_blocks_sylius_%kernel.environment%?serverVersion=8.0&charset=utf8mb4
BUNDLES_TO_ENABLE='ContentBlocks\ContentBlocksBundle;ContentBlocks\Kit\ContentBlocksKitBundle;ContentBlocks\I18n\ContentBlocksI18nBundle;ContentBlocks\Media\ContentBlocksMediaBundle;ContentBlocks\Sylius\ContentBlocksSyliusPlugin'
CONFIGS_TO_IMPORT='@ContentBlocksSyliusPlugin/tests/TestApplication/config/config.yaml'
ROUTES_TO_IMPORT='@ContentBlocksSyliusPlugin/config/routes.yaml;@ContentBlocksSyliusPlugin/config/routes/i18n.yaml;@ContentBlocksSyliusPlugin/config/routes/media.yaml'
