{% from '@SyliusAdmin/shared/helper/translations.html.twig' import default as translations %}
{% set form = hookable_metadata.context.form %}

<div class="col-12 col-lg-4">
    <div class="card mb-3">
        <div class="card-body">
            {{ form_row(form.code) }}
            {{ form_row(form.enabled) }}
            {{ form_row(form.channels) }}
        </div>
    </div>
</div>
<div class="col-12 col-lg-8">
    <div class="card mb-3">
        <div class="card-header"><div class="card-title">{{ 'sylius.ui.translations'|trans }}</div></div>
        <div class="card-body">
            {{ translations(form.translations, null, { accordion_flush: true }) }}
        </div>
    </div>
</div>
