{# The tag stays semantic, Bootstrap's h1-h6 classes give the size. #}
{% if data.text|default %}
    {% set tag = data.tag|default('h2') %}
    {% set tag = tag in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'span', 'p'] ? tag : 'h2' %}
    {% set size = data.size|default(tag in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'h2') %}
    {% set size = cb_kit_token(size, 'h2') %}
    {% set class = size in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] ? size : 'cb-kit-title--' ~ size %}
    {% set color = cb_css_color(data.color|default('')) %}
    <{{ tag }} class="{{ class }} mb-0"{% if color is not empty %} style="color: {{ color|e('html_attr') }}"{% endif %}>{{ data.text }}</{{ tag }}>
{% else %}
    <small class="text-body-secondary">{{ 'cb_kit.block.title.empty'|trans({}, 'content_blocks_kit') }}</small>
{% endif %}
