{# The builder sidebars' own widgets: styling, icon choices. Loaded by both
   sidebars, never globally, so the host's form theme is untouched. #}

{# Its children gathered into their `cb_panel` panels. #}
{% block cb_styling_widget %}
    {% import '@ContentBlocks/form/_sidebar.html.twig' as sidebar %}
    <div class="cb-styling">
        {{ sidebar.panels(form, 'styling', {
            name: id ~ '-panels',
            exclusive: cb_panels_exclusive ?? true,
        }) }}
    </div>
{% endblock %}

{# Length: value + unit select, side by side. #}
{% block cb_length_widget %}
    <div class="cb-length cb-form-input-group">
        {{ form_widget(form.value) }}
        {{ form_widget(form.unit, { attr: { class: 'cb-length__unit' } }) }}
    </div>
{% endblock %}

{# Box-spacing: 4 inputs (T/R/B/L) + link toggle. #}
{% block cb_box_spacing_widget %}
    {% set sides = [
        { key: 'top',    label: 'cb.styling.side.top' },
        { key: 'right',  label: 'cb.styling.side.right' },
        { key: 'bottom', label: 'cb.styling.side.bottom' },
        { key: 'left',   label: 'cb.styling.side.left' },
    ] %}
    <div class="cb-box-spacing"
         data-controller="cb-spacing-link"
         data-cb-spacing-link-linked-value="{{ form.linked.vars.value ? 'true' : 'false' }}">
        <div class="cb-box-spacing__sides">
            {% for side in sides %}
                <div class="cb-box-spacing__side">
                    <label class="cb-box-spacing__label" for="{{ form[side.key].vars.id }}">
                        {{ side.label|trans({}, 'content_blocks') }}
                    </label>
                    {{ form_widget(form[side.key], {
                        attr: {
                            class: 'cb-box-spacing__input',
                            'data-cb-spacing-link-target': 'input',
                        }
                    }) }}
                </div>
            {% endfor %}
            <button type="button"
                    class="cb-box-spacing__link"
                    data-cb-spacing-link-target="toggle"
                    data-action="cb-spacing-link#toggle"
                    aria-pressed="{{ form.linked.vars.value ? 'true' : 'false' }}"
                    title="{{ 'cb.styling.link_sides'|trans({}, 'content_blocks') }}">
                <span aria-hidden="true">⛓</span>
            </button>
        </div>
        <div class="cb-box-spacing__linked-state" hidden>
            {{ form_widget(form.linked) }}
        </div>
    </div>
{% endblock %}

{# Responsive box-spacing: D/T/M tabs above a single BoxSpacing view. #}
{% block cb_responsive_box_spacing_row %}
    <div class="cb-form-row">
        <div class="cb-form-row__header">
            <label class="cb-form-label">{{ form.vars.label|trans({}, 'content_blocks') }}</label>
            <div class="cb-viewport-tabs" data-controller="cb-viewport-tabs" data-cb-viewport-tabs-active-value="desktop">
                {# Matches the topbar viewport switcher. #}
                {% set viewports = [
                    { key: 'desktop', icon: '▭', label: 'cb.styling.viewport.desktop' },
                    { key: 'tablet', icon: '▢', label: 'cb.styling.viewport.tablet' },
                    { key: 'mobile', icon: '▯', label: 'cb.styling.viewport.mobile' },
                ] %}
                {% for v in viewports %}
                    <button type="button"
                            class="cb-viewport-tabs__btn"
                            data-cb-viewport-tabs-target="tab"
                            data-viewport="{{ v.key }}"
                            data-action="cb-viewport-tabs#select"
                            aria-pressed="{{ v.key == 'desktop' ? 'true' : 'false' }}"
                            title="{{ v.label|trans({}, 'content_blocks') }}">
                        <span aria-hidden="true">{{ v.icon }}</span>
                    </button>
                {% endfor %}
            </div>
        </div>
        {{ form_widget(form) }}
    </div>
{% endblock %}

{% block cb_responsive_box_spacing_widget %}
    <div class="cb-responsive-box-spacing">
        {% for vp in ['desktop', 'tablet', 'mobile'] %}
            <div class="cb-responsive-box-spacing__viewport" data-viewport="{{ vp }}">
                {{ form_widget(form[vp]) }}
            </div>
        {% endfor %}
    </div>
{% endblock %}

{# Responsive single length (e.g. gap): same D/T/M tabs, a single input. #}
{% block cb_responsive_length_row %}
    <div class="cb-form-row">
        <div class="cb-form-row__header">
            <label class="cb-form-label">{{ form.vars.label|trans({}, 'content_blocks') }}</label>
            <div class="cb-viewport-tabs" data-controller="cb-viewport-tabs" data-cb-viewport-tabs-active-value="desktop">
                {% set viewports = [
                    { key: 'desktop', icon: '▭', label: 'cb.styling.viewport.desktop' },
                    { key: 'tablet', icon: '▢', label: 'cb.styling.viewport.tablet' },
                    { key: 'mobile', icon: '▯', label: 'cb.styling.viewport.mobile' },
                ] %}
                {% for v in viewports %}
                    <button type="button"
                            class="cb-viewport-tabs__btn"
                            data-cb-viewport-tabs-target="tab"
                            data-viewport="{{ v.key }}"
                            data-action="cb-viewport-tabs#select"
                            aria-pressed="{{ v.key == 'desktop' ? 'true' : 'false' }}"
                            title="{{ v.label|trans({}, 'content_blocks') }}">
                        <span aria-hidden="true">{{ v.icon }}</span>
                    </button>
                {% endfor %}
            </div>
        </div>
        {{ form_widget(form) }}
    </div>
{% endblock %}

{% block cb_responsive_length_widget %}
    <div class="cb-responsive-length">
        {% for vp in ['desktop', 'tablet', 'mobile'] %}
            <div class="cb-responsive-length__viewport" data-viewport="{{ vp }}">
                <span class="cb-length cb-form-input-group">
                    {{ form_widget(form[vp], { attr: { class: 'cb-responsive-length__input' } }) }}
                    {# The unit class is only a width cap, so a bare span
                       needs the addon treatment too. #}
                    <span class="cb-length__unit cb-responsive-length__unit cb-form-input-group__addon">px</span>
                </span>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{# `cb_icons`: one icon button per choice over its native input, kept in
   the DOM so keyboard, forms and autosave behave as for a plain radio. #}
{% block cb_icon_choice_widget -%}
    {%- set domain = choice_translation_domain is same as(false) ? false : (choice_translation_domain ?? translation_domain) -%}
    {# Options follow the order of `cb_icons`; the rest trail, as text. #}
    {%- set by_value = {} -%}
    {%- for child in form -%}
        {%- set by_value = by_value|merge({('v' ~ child.vars.value): child}) -%}
    {%- endfor -%}
    {%- set ordered = [] -%}
    {%- for value, icon in cb_icons -%}
        {%- if by_value['v' ~ value] is defined -%}
            {%- set ordered = ordered|merge([by_value['v' ~ value]]) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- for child in form -%}
        {%- if cb_icons[child.vars.value] is not defined -%}
            {%- set ordered = ordered|merge([child]) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- set classes = 'cb-icon-choice cb-icon-choice--' ~ cb_icon_layout ~ (cb_icon_labels ? ' cb-icon-choice--labelled' : '') -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' ' ~ classes)|trim}) -%}
    {%- if cb_icon_columns -%}
        {%- set attr = attr|merge({style: ('--cb-icon-cols: ' ~ cb_icon_columns ~ '; ' ~ attr.style|default(''))|trim}) -%}
    {%- endif -%}
    <div {{ block('widget_container_attributes') }} role="{{ multiple ? 'group' : 'radiogroup' }}">
        {%- for child in ordered -%}
            {%- set label = child.vars.label -%}
            {%- set text = label is same as(false) ? child.vars.value
                : (label is empty ? child.vars.value
                : (domain is same as(false) ? label : label|trans(child.vars.label_translation_parameters|default({}), domain))) -%}
            {%- set icon = cb_icons[child.vars.value] ?? null -%}
            {%- set svg = icon ? cb_ui_icon(icon) : '' -%}
            <label class="cb-icon-choice__option{{ svg|length > 0 ? '' : ' cb-icon-choice__option--text' }}" for="{{ child.vars.id }}" title="{{ text }}">
                <input type="{{ multiple ? 'checkbox' : 'radio' }}"
                       class="cb-icon-choice__input"
                       id="{{ child.vars.id }}"
                       name="{{ child.vars.full_name }}"
                       value="{{ child.vars.value }}"
                       {%- if child.vars.checked %} checked="checked"{% endif %}
                       {%- if child.vars.disabled %} disabled="disabled"{% endif %}
                       {%- if child.vars.required and not multiple %} required="required"{% endif %}
                       {%- for attrname, attrvalue in child.vars.attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>
                <span class="cb-icon-choice__face">
                    {{- svg -}}
                    <span class="{{ svg|length > 0 and not cb_icon_labels ? 'cb-form-sr-only' : 'cb-icon-choice__text' }}">{{ text }}</span>
                </span>
            </label>
        {%- endfor -%}
    </div>
{%- endblock cb_icon_choice_widget %}

{# Slides per view: the same D/T/M tabs, one number each. #}
{% block cb_slider_per_view_row %}
    <div class="cb-form-row"{% for attrName, attrValue in row_attr %} {{ attrName }}="{{ attrValue }}"{% endfor %}>
        <div class="cb-form-row__header">
            <label class="cb-form-label">{{ form.vars.label|trans({}, 'content_blocks') }}</label>
            {{ include('@ContentBlocks/form/_viewport_tabs.html.twig') }}
        </div>
        <div class="cb-responsive-length">
            {% for vp in ['desktop', 'tablet', 'mobile'] %}
                <div class="cb-responsive-length__viewport" data-viewport="{{ vp }}">
                    {{ form_widget(form[vp], { attr: { class: 'cb-responsive-length__input' } }) }}
                </div>
            {% endfor %}
        </div>
        {{ form_errors(form) }}
    </div>
{% endblock %}
