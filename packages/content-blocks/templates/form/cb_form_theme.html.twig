{# Form theme: the framework-neutral `form_div_layout` with cb-* classes
   layered on, pairing with the scoped forms.css. #}

{# Opt-in — loaded by the Block and Section components through a local
   `form_theme`, never prepended globally, so host forms are untouched. #}

{% use 'form_div_layout.html.twig' %}


{# ---- Widgets ---- #}

{# The parent HiddenType makes the row resolve to `hidden_row` — widget
   only — and this replaces the hidden input with an <hr>. #}
{% block cb_separator_widget -%}
    <hr class="cb-form-separator" />
{%- endblock cb_separator_widget %}


{% block form_widget_simple -%}
    {%- set widget_class = 'cb-form-control' -%}
    {%- if type|default('') == 'color' -%}
        {%- set widget_class = widget_class ~ ' cb-form-control--color' -%}
    {%- elseif type|default('') == 'range' -%}
        {# Range gets a totally different visual; swap classes entirely
           so cb-form-control's padding/border don't sneak in. #}
        {%- set widget_class = 'cb-form-range' -%}
    {%- endif -%}
    {# Skipped for hidden inputs, and for checkbox/radio, which the
       cb-form-check rules drive instead. #}
    {%- if type|default('') not in ['hidden', 'checkbox', 'radio'] -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' ' ~ widget_class)|trim}) -%}
    {%- endif -%}
    {%- if type is defined and type in ['range', 'color'] -%}
        {# Browsers do not honour `required` on these, so it would only
           add a UA validation the editor can never satisfy. #}
        {%- set required = false -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}


{% block widget_attributes -%}
    {%- if not valid -%}
        {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-control--invalid')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes %}


{% block textarea_widget -%}
    {# The parent already renders the <textarea> with attr's class, so
       only the class itself needs setting. #}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-control')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}


{% block choice_widget_collapsed -%}
    {%- set widget_class = 'cb-form-select' -%}
    {%- if not valid -%}
        {%- set widget_class = widget_class ~ ' cb-form-select--invalid' -%}
    {%- endif -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' ' ~ widget_class)|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}


{% block choice_widget_expanded -%}
    {# A compact stack; the class marks our flex layout apart from the
       plain <div> default. Inline is opt-in. #}
    {%- set list_class = 'cb-form-choice-list' -%}
    {%- if attr.inline|default(false) -%}
        {%- set list_class = list_class ~ ' cb-form-choice-list--inline' -%}
    {%- endif -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' ' ~ list_class)|trim}) -%}
    <div {{ block('widget_container_attributes') }}>
        {%- for child in form -%}
            {{- form_widget(child, {
                parent_label_class: label_attr.class|default(''),
                translation_domain: choice_translation_domain,
                valid: valid,
            }) -}}
        {%- endfor -%}
    </div>
{%- endblock choice_widget_expanded %}


{# Not form_label: the neutral layout's has no widget-dispatch, and this
   <label> must carry `cb-form-check__label` instead. #}
{% block _cb_form_check_render -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-check__input')|trim}) -%}
    {# The neutral layout emits `checked` from the widget blocks, not from
       form_widget_simple — which is what this routes through. #}
    {%- if checked|default(false) -%}
        {%- set attr = attr|merge({checked: true}) -%}
    {%- endif -%}
    {%- set row_class = 'cb-form-check' -%}
    {%- set parent_label_class = parent_label_class|default(label_attr.class|default('')) -%}
    {%- if 'cb-form-check--inline' in parent_label_class or 'inline' in parent_label_class -%}
        {%- set row_class = row_class ~ ' cb-form-check--inline' -%}
    {%- endif -%}
    {%- if 'cb-form-check--switch' in parent_label_class or 'switch' in parent_label_class -%}
        {%- set row_class = row_class ~ ' cb-form-check--switch' -%}
    {%- endif -%}
    <div class="{{ row_class }}">
        {{- block('form_widget_simple') -}}
        {%- if label is not same as(false) -%}
            {%- set label_class = (label_attr.class|default('') ~ ' cb-form-check__label')|trim -%}
            {%- set label_attr = label_attr|merge({class: label_class, for: id}) -%}
            <label{% with {attr: label_attr} %}{{ block('attributes') }}{% endwith %}>
                {{- block('form_label_content') -}}
            </label>
        {%- endif -%}
    </div>
{%- endblock _cb_form_check_render %}


{% block checkbox_widget -%}
    {%- set type = type|default('checkbox') -%}
    {{- block('_cb_form_check_render') -}}
{%- endblock checkbox_widget %}


{% block radio_widget -%}
    {%- set type = type|default('radio') -%}
    {{- block('_cb_form_check_render') -}}
{%- endblock radio_widget %}


{% block file_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-file')|trim}) -%}
    {%- set type = type|default('file') -%}
    {{- block('form_widget_simple') -}}
{%- endblock file_widget %}


{# The **number** input carries the name and is the submitted field, so an
   editor can type a value off the slider's step grid. #}
{% block range_widget -%}
    {%- set required = false -%}
    {%- set slider_min = attr.min|default('') -%}
    {%- set slider_max = attr.max|default('') -%}
    {%- set slider_step = attr.step|default('') -%}
    {%- set precise_step = attr.precise_step|default(1) -%}
    {%- set has_value = value is defined and value is not null and value|trim != '' -%}
    {# Strip our private `precise_step` key (it isn't a real HTML attribute)
       and point the number input's step at it instead of the slider step. #}
    {%- set attr = attr|filter((v, k) => k != 'precise_step')|merge({
        class: (attr.class|default('') ~ ' cb-form-range-wrap__number')|trim,
        step: precise_step,
    }) -%}
    <div class="cb-form-range-wrap" data-controller="cb-range">
        <input type="number"
               {{- block('widget_attributes') }}
               {% if has_value %}value="{{ value }}"{% endif %}
               data-cb-range-target="number"
               data-action="input->cb-range#fromNumber change->cb-range#clampNumber" />
        <input type="range"
               class="cb-form-range"
               {% if slider_min is not same as('') %}min="{{ slider_min }}"{% endif %}
               {% if slider_max is not same as('') %}max="{{ slider_max }}"{% endif %}
               {% if slider_step is not same as('') %}step="{{ slider_step }}"{% endif %}
               {% if has_value %}value="{{ value }}"{% endif %}
               data-cb-range-target="slider"
               data-action="input->cb-range#fromSlider change->cb-range#commitSlider"
               tabindex="-1"
               aria-hidden="true" />
        <div class="cb-form-range-wrap__bounds">
            <span>{{ slider_min }}</span>
            <span>{{ slider_max }}</span>
        </div>
    </div>
{%- endblock range_widget %}


{% block money_widget -%}
    {%- set prepend = not (money_pattern starts with '{{') -%}
    {%- set append = not (money_pattern ends with '}}') -%}
    {%- if prepend or append -%}
        <div class="cb-form-input-group">
            {%- if prepend -%}
                <span class="cb-form-input-group__addon">{{ money_pattern|form_encode_currency }}</span>
            {%- endif -%}
            {{- block('form_widget_simple') -}}
            {%- if append -%}
                <span class="cb-form-input-group__addon">{{ money_pattern|form_encode_currency }}</span>
            {%- endif -%}
        </div>
    {%- else -%}
        {{- block('form_widget_simple') -}}
    {%- endif -%}
{%- endblock money_widget %}


{% block percent_widget -%}
    {%- if symbol -%}
        <div class="cb-form-input-group">
            {{- block('form_widget_simple') -}}
            <span class="cb-form-input-group__addon">{{ symbol|default('%') }}</span>
        </div>
    {%- else -%}
        {{- block('form_widget_simple') -}}
    {%- endif -%}
{%- endblock percent_widget %}


{% block date_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        {%- if not valid -%}
            {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-control--invalid')|trim}) -%}
            {%- set valid = true -%}
        {%- endif -%}
        {%- if datetime is not defined or not datetime -%}
            <div {{ block('widget_container_attributes') -}}>
        {%- endif -%}
        {%- if label is not same as(false) -%}
            <div class="cb-form-sr-only">
                {{- form_label(form.year) -}}
                {{- form_label(form.month) -}}
                {{- form_label(form.day) -}}
            </div>
        {%- endif -%}
        <div class="cb-form-input-group">
            {{- date_pattern|replace({
                '{{ year }}': form_widget(form.year),
                '{{ month }}': form_widget(form.month),
                '{{ day }}': form_widget(form.day),
            })|raw -}}
        </div>
        {%- if datetime is not defined or not datetime -%}
            </div>
        {%- endif -%}
    {%- endif -%}
{%- endblock date_widget %}


{% block time_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        {%- if not valid -%}
            {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-control--invalid')|trim}) -%}
            {%- set valid = true -%}
        {%- endif -%}
        {%- if datetime is not defined or false == datetime -%}
            <div {{ block('widget_container_attributes') -}}>
        {%- endif -%}
        {%- if label is not same as(false) -%}
            <div class="cb-form-sr-only">
                {{- form_label(form.hour) -}}
                {%- if with_minutes -%}{{ form_label(form.minute) }}{%- endif -%}
                {%- if with_seconds -%}{{ form_label(form.second) }}{%- endif -%}
            </div>
        {%- endif -%}
        {%- if with_minutes or with_seconds %}
            <div class="cb-form-input-group">
        {% endif -%}
        {{- form_widget(form.hour) -}}
        {%- if with_minutes -%}
            <span class="cb-form-input-group__addon">:</span>
            {{- form_widget(form.minute) -}}
        {%- endif -%}
        {%- if with_seconds -%}
            <span class="cb-form-input-group__addon">:</span>
            {{- form_widget(form.second) -}}
        {%- endif -%}
        {%- if with_minutes or with_seconds %}
            </div>
        {% endif -%}
        {%- if datetime is not defined or false == datetime -%}
            </div>
        {%- endif -%}
    {%- endif -%}
{%- endblock time_widget %}


{% block datetime_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        <div {{ block('widget_container_attributes') }}>
            {{- form_widget(form.date, {datetime: true}) -}}
            {{- form_errors(form.date) -}}
            {{- form_widget(form.time, {datetime: true}) -}}
            {{- form_errors(form.time) -}}
        </div>
    {%- endif -%}
{%- endblock datetime_widget %}


{% block button_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-btn')|trim}) -%}
    {{- parent() -}}
{%- endblock button_widget %}


{% block submit_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-btn cb-form-btn--primary')|trim}) -%}
    {{- parent() -}}
{%- endblock submit_widget %}


{% block reset_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' cb-form-btn')|trim}) -%}
    {{- parent() -}}
{%- endblock reset_widget %}


{# ---- Labels ---- #}

{% block form_label -%}
    {%- if label is not same as(false) -%}
        {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' cb-form-label')|trim}) -%}
        {%- if compound is defined and compound -%}
            {# Compound forms render <legend> instead of <label>. Use the
               same class so legends pick up the same typography. #}
            {%- set element = 'legend' -%}
        {%- endif -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_label %}


{# ---- Rows ---- #}

{% block form_row -%}
    {%- if compound is defined and compound -%}
        {%- set element = 'fieldset' -%}
    {%- endif -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ "_help"}} -%}
    {%- endif -%}
    {%- set row_class = row_class|default(row_attr.class|default('cb-form-row')|trim) -%}
    {# `type` is only set inside the widget block, so the row detects a
       range through block_prefixes instead. #}
    {%- if block_prefixes is defined and 'range' in block_prefixes -%}
        {%- set row_class = (row_class ~ ' cb-form-row--range')|trim -%}
    {%- endif -%}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </{{ element|default('div') }}>
{%- endblock form_row %}


{# A standalone checkbox already labels itself beside the box, so the
   generic row would print the same text twice. #}

{# Radio groups keep their row label: there it names the group, not the
   option. Same for a switch, whose label is its only text. #}
{% block checkbox_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~ "_help"}} -%}
    {%- endif -%}
    {%- set row_class = row_class|default(row_attr.class|default('cb-form-row')|trim) -%}
    <div{% with {attr: row_attr|merge({class: row_class})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form, widget_attr) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row %}


{% block button_row -%}
    <div{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' cb-form-row')|trim})} %}{{ block('attributes') }}{% endwith %}>
        {{- form_widget(form) -}}
    </div>
{%- endblock button_row %}


{# ---- Errors ---- #}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        {%- set class = form is rootform ? 'cb-form-errors cb-form-errors--root' : 'cb-form-errors' -%}
        <ul class="{{ class }}" id="{{ id ~ '_errors' }}">
            {%- for error in errors -%}
                <li id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}


{# ---- Help ---- #}

{% block form_help -%}
    {%- if help is not empty -%}
        {%- set help_attr = help_attr|merge({class: (help_attr.class|default('') ~ ' cb-form-help')|trim}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock form_help %}


{# ---- Live Collection ----
   A grid of cards rather than a stack of fieldsets. #}

{% block live_collection_widget -%}
    {# The container itself carries the grid class and becomes the
       SortableJS list. #}

    {# `name` is the collection's full_name, matching what add and delete
       send — the live action strips the root form prefix. #}
    {%- set attr = attr|merge({
        class: (attr.class|default('') ~ ' cb-form-collection')|trim,
        'data-controller': ('cb-collection-sort ' ~ attr['data-controller']|default(''))|trim,
        'data-cb-collection-sort-name-value': full_name,
    }) -%}
    {{ block('form_widget') }}
    {%- if skip_add_button|default(false) is same as(false) and button_add is defined and not button_add.rendered -%}
        {{ form_row(button_add, {row_attr: {class: 'cb-form-collection__add-row'}}) }}
    {%- endif -%}
{%- endblock live_collection_widget %}

{% block live_collection_entry_row -%}
    <div class="cb-form-collection__item">
        {# A drag handle plus keyboard up/down. They carry no `name`, so
           they are never serialized into the form. #}
        <div class="cb-form-collection__controls">
            <button type="button"
                    class="cb-form-collection__drag-handle"
                    aria-label="{{ 'cb.collection.reorder'|trans({}, 'content_blocks') }}"
                    title="{{ 'cb.collection.reorder'|trans({}, 'content_blocks') }}"
                    tabindex="-1"
                    aria-hidden="true">⠿</button>
            <button type="button"
                    class="cb-form-collection__move cb-form-collection__move--up"
                    data-action="cb-collection-sort#moveUp"
                    aria-label="{{ 'cb.collection.move_up'|trans({}, 'content_blocks') }}"
                    title="{{ 'cb.collection.move_up'|trans({}, 'content_blocks') }}">▲</button>
            <button type="button"
                    class="cb-form-collection__move cb-form-collection__move--down"
                    data-action="cb-collection-sort#moveDown"
                    aria-label="{{ 'cb.collection.move_down'|trans({}, 'content_blocks') }}"
                    title="{{ 'cb.collection.move_down'|trans({}, 'content_blocks') }}">▼</button>
            {# Carries no `name`, so it is never serialized.
               See docs/internals/forms.md #}
            <button type="button"
                    class="cb-form-collection__move cb-form-collection__duplicate"
                    data-action="cb-collection-sort#duplicate"
                    aria-label="{{ 'cb.collection.duplicate'|trans({}, 'content_blocks') }}"
                    title="{{ 'cb.collection.duplicate'|trans({}, 'content_blocks') }}">⧉</button>
        </div>
        {# Strip the cb-form-row margin from the inner fieldset — the
           item card already provides spacing via the grid gap. #}
        {%- set row_attr = row_attr|default({})|merge({class: (row_attr.class|default('') ~ ' cb-form-collection__item-body')|trim}) -%}
        {{ block('form_row') }}
        {%- if button_delete is defined and not button_delete.rendered -%}
            {{ form_row(button_delete, {
                row_attr: {class: 'cb-form-collection__delete-row'},
                label: '×',
                attr: {
                    'class': 'cb-form-btn cb-form-collection__delete',
                    'aria-label': 'Remove',
                    'title': 'Remove',
                },
            }) }}
        {%- endif -%}
    </div>
{%- endblock live_collection_entry_row %}

{# ---------- Image upload field (ImageUploadType) ----------
   The whole widget is a drop zone, and only file drags are intercepted. #}

{# Routed back through the standard row: parenting HiddenType makes Symfony
   pick `hidden_row`, which left this visible control nameless. #}
{% block cb_image_upload_row -%}
    {{- block('form_row') -}}
{%- endblock cb_image_upload_row %}

{% block cb_image_upload_widget -%}
    {%- set src = form.vars.value -%}
    <div data-controller="cb-file-upload"
         class="cb-image-upload{% if not src %} cb-image-upload--empty{% endif %}"
         data-action="dragenter->cb-file-upload#dragEnter dragover->cb-file-upload#dragOver dragleave->cb-file-upload#dragLeave drop->cb-file-upload#drop"
         data-i18n-cb-upload-uploading="{{ 'cb.upload.uploading'|trans({}, 'content_blocks') }}"
         data-i18n-cb-upload-failed="{{ 'cb.upload.failed'|trans({}, 'content_blocks') }}"
         data-i18n-cb-upload-network-error="{{ 'cb.upload.network_error'|trans({}, 'content_blocks') }}"
         data-i18n-cb-upload-rejected="{{ 'cb.upload.rejected'|trans({}, 'content_blocks') }}">

        {# The frame is the affordance once there is an image, so the hint
           only shows on an empty field or mid-drag. #}
        <div class="cb-image-upload__preview">
            <img data-cb-file-upload-target="preview"
                 {% if src %}src="{{ src }}"{% endif %}
                 class="cb-thumbnail"
                 alt=""
                 {% if not src %}hidden{% endif %}>
            <p class="cb-image-upload__hint">{{ 'cb.upload.drop_hint'|trans({}, 'content_blocks') }}</p>
        </div>

        <div class="cb-image-upload__actions">
            {# Visually hidden inside its label, which keeps the click, the
               focus and the accessible name with no JS. #}
            <label class="cb-form-btn cb-form-btn--sm cb-image-upload__choose">
                {{ 'cb.upload.choose'|trans({}, 'content_blocks') }}
                <input type="file"
                       class="cb-image-upload__file"
                       accept="{{ accept|default('image/*') }}"
                       data-cb-file-upload-target="file"
                       data-action="change->cb-file-upload#upload:stop">
            </label>
            {# Server-side too: a Live morph would otherwise bring it back
               on an empty field. #}
            <button type="button"
                    class="cb-form-btn cb-form-btn--sm"
                    data-cb-file-upload-target="remove"
                    data-action="cb-file-upload#remove"
                    {% if not src %}hidden{% endif %}>{{ 'cb.upload.remove'|trans({}, 'content_blocks') }}</button>
            <button type="button"
                    class="cb-form-btn cb-form-btn--sm cb-image-upload__path-toggle"
                    data-action="cb-file-upload#togglePath"
                    aria-expanded="false"
                    title="{{ 'cb.upload.path_toggle'|trans({}, 'content_blocks') }}"
                    aria-label="{{ 'cb.upload.path_toggle'|trans({}, 'content_blocks') }}">🔗</button>
        </div>

        {# Nameless on purpose: only the hidden input is submitted. #}
        <input type="text"
               class="cb-form-control cb-image-upload__path"
               data-cb-file-upload-target="path"
               data-action="input->cb-file-upload#editPath change->cb-file-upload#commitPath keydown->cb-file-upload#pathKeydown"
               placeholder="{{ 'cb.upload.path_placeholder'|trans({}, 'content_blocks') }}"
               value="{{ src }}"
               hidden>

        <span data-cb-file-upload-target="status" class="cb-upload-status"></span>

        {# Hidden input carrying the stored path; targets set by the type. #}
        {{ block('hidden_widget') }}
    </div>
{%- endblock cb_image_upload_widget %}
