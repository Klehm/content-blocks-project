{# @var section \ContentBlocks\Entity\Section #}
{# @var isPreview bool #}
{# @var chrome bool — see content_area.html.twig #}
{% set chrome = chrome is defined ? chrome : isPreview %}
{% set desktop = section.display ?? 'grid' %}
{% set displays = section.displays ?? { desktop: desktop, tablet: desktop, mobile: desktop } %}
{% set slider = section.slider ?? null %}
<section class="cb-section cb-section--{{ section.layout }}{% if section.deleted %} cb-section--deleted{% endif %}{% if section.extraClasses %} {{ section.extraClasses }}{% endif %}"
    {% if isPreview %}data-cb-section-id="{{ section.id }}"{% endif %}
    {% if section.deleted %}data-cb-deleted="1"{% endif %}
    {% if section.inlineStyle %}style="{{ section.inlineStyle }}"{% endif %}
    {% if slider %}data-cb-slider="{{ slider|merge({ labels: {
        carousel: 'cb.slider.carousel'|trans({}, 'content_blocks'),
        slide: 'cb.slider.slide'|trans({}, 'content_blocks'),
        previous: 'cb.slider.previous'|trans({}, 'content_blocks'),
        next: 'cb.slider.next'|trans({}, 'content_blocks'),
        goto: 'cb.slider.goto'|trans({}, 'content_blocks'),
    } })|json_encode }}"{% endif %}
    {% for k, v in section.extraAttributes %} {{ k }}="{{ v }}"{% endfor %}>
    {% if chrome %}
        {# A direct child of <section>, not of .cb-row, so the overlay
           routes a click on it as a section click. #}
        <button type="button"
                class="cb-section-handle"
                aria-label="{{ 'cb.section.select'|trans({}, 'content_blocks') }}"
                title="{{ 'cb.section.select'|trans({}, 'content_blocks') }}">
            <span class="cb-section-handle__grip" aria-hidden="true">⋮⋮</span>
            {{ 'cb.section.handle'|trans({}, 'content_blocks') }}
        </button>
    {% endif %}
    {% set columns = chrome ? section.columns : section.columns|filter(c => not c.deleted) %}
    {% set tabs = desktop == 'tabs' %}
    {# Tabs turning into an accordion keep the tab radios: see
       docs/internals/rendering.md#display-per-viewport #}
    {% set tabsAccordion = tabs and 'accordion' in displays %}
    {% set accordion = not tabs and 'accordion' in displays %}
    {% set single = accordion and (section.accordion.single ?? false) %}
    {% if tabs or accordion %}
        {% set panelsId = 'cb-' ~ (tabs ? 'tabs' : 'accordion') ~ '-' ~ section.id %}
        {# The builder keeps a column pending deletion: open the first live. #}
        {% set openIndex = null %}
        {% if not (accordion and (section.accordion.collapsed ?? false)) %}
            {% for column in columns %}
                {% if openIndex is null and not column.deleted %}{% set openIndex = loop.index0 %}{% endif %}
            {% endfor %}
        {% endif %}
    {% endif %}
    {# CSS-only tabs: radios, then the labels, then the row, so `:checked ~`
       reaches both. See docs/internals/rendering.md#columns-and-tabs #}
    {% if tabs %}
        {% for column in columns %}
            <input type="radio" class="cb-tabs__radio" name="{{ panelsId }}" id="{{ panelsId }}-{{ loop.index0 }}"
                   aria-controls="{{ panelsId }}-{{ loop.index0 }}-panel"{% if loop.index0 is same as(openIndex) %} checked{% endif %}>
        {% endfor %}
        <div class="cb-tabs__nav">
            {% for column in columns %}
                <label for="{{ panelsId }}-{{ loop.index0 }}" id="{{ panelsId }}-{{ loop.index0 }}-label"
                       class="cb-tabs__tab{% if column.deleted %} cb-tabs__tab--deleted{% endif %}">
                    {{- column.label ?? ('cb.section.tabs.untitled'|trans({ '%n%': loop.index }, 'content_blocks')) -}}
                </label>
            {% endfor %}
        </div>
    {% endif %}
    <div class="cb-row">
        {# One at a time: radios, plus a "none" one that the open header's
           twin label checks, since a radio cannot be unchecked. #}
        {% if single %}
            <input type="radio" class="cb-accordion__toggle cb-accordion__none" name="{{ panelsId }}"
                   id="{{ panelsId }}-none" tabindex="-1" aria-hidden="true"{% if openIndex is null %} checked{% endif %}>
        {% endif %}
        {% for column in columns %}
            {% if tabsAccordion %}
                <label for="{{ panelsId }}-{{ loop.index0 }}" class="cb-accordion__header{% if column.deleted %} cb-accordion__header--deleted{% endif %}">
                    {{- column.label ?? ('cb.section.tabs.untitled'|trans({ '%n%': loop.index }, 'content_blocks')) -}}
                </label>
            {% endif %}
            {# Accordion: a toggle and its header right before each panel,
               so `:checked + label + .cb-col` opens it. #}
            {% if accordion %}
                {% set title = column.label ?? ('cb.section.accordion.untitled'|trans({ '%n%': loop.index }, 'content_blocks')) %}
                {% set deletedClass = column.deleted ? ' cb-accordion__header--deleted' : '' %}
                {% if single %}
                    <input type="radio" class="cb-accordion__toggle" name="{{ panelsId }}" id="{{ panelsId }}-{{ loop.index0 }}"
                           aria-controls="{{ panelsId }}-{{ loop.index0 }}-panel"{% if loop.index0 is same as(openIndex) %} checked{% endif %}>
                {% else %}
                    <input type="checkbox" class="cb-accordion__toggle" id="{{ panelsId }}-{{ loop.index0 }}"
                           aria-controls="{{ panelsId }}-{{ loop.index0 }}-panel"{% if loop.index0 is same as(openIndex) %} checked{% endif %}>
                {% endif %}
                <label for="{{ panelsId }}-{{ loop.index0 }}" id="{{ panelsId }}-{{ loop.index0 }}-label"
                       class="cb-accordion__header{{ deletedClass }}">
                    {{- title -}}
                </label>
                {% if single %}
                    <label for="{{ panelsId }}-none" class="cb-accordion__header cb-accordion__header--close{{ deletedClass }}">
                        {{- title -}}
                    </label>
                {% endif %}
            {% endif %}
            {{ include('@ContentBlocks/render/column.html.twig', {
                column: column,
                isPreview: isPreview,
                chrome: chrome,
                panelId: tabs or accordion ? panelsId ~ '-' ~ loop.index0 : null,
            }, with_context = false) }}
        {% endfor %}
    </div>
</section>
