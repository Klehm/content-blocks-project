{# @var sections array #}
{# @var mode \ContentBlocks\Rendering\RenderMode #}
{% set isPreview = mode.value == 'preview' %}
{# `is defined`, not |default(): the filter treats `false` as empty and
   would flip the chrome back on. See docs/internals/rendering.md #}
{% set chrome = chrome is defined ? chrome : isPreview %}
<link rel="stylesheet" href="{{ path('content_blocks_asset_layout') }}">
<link rel="stylesheet" href="{{ path('content_blocks_asset_styling') }}">
{% if chrome %}
    <link rel="stylesheet" href="{{ path('content_blocks_asset_builder') }}">
{% endif %}
{# Without the chrome there is nothing to explain a struck-through section, so
   what is pending deletion is simply left out — the published shape. #}
{% set visibleSections = chrome ? sections : sections|filter(s => not s.deleted) %}
{# Hidden sections do not count: deleting the last one shows the empty state. #}
{% set isEmpty = sections|filter(s => not s.deleted) is empty %}
{# The empty-state class is a builder affordance ("nothing here yet, add a
   section"), so it follows the chrome rather than the mode. #}
<div class="cb-content-area{% if chrome and isEmpty %} cb-content-area--empty{% endif %}"{% if isPreview %} data-cb-preview="1"{% endif %}>
{% for section in visibleSections %}
    {{ include('@ContentBlocks/render/section.html.twig', { section: section, isPreview: isPreview, chrome: chrome }, with_context = false) }}
{% endfor %}
{% if chrome %}
    {% set trayLabel = isEmpty
        ? 'cb.builder.empty_cta'|trans({}, 'content_blocks')
        : 'cb.builder.add_section'|trans({}, 'content_blocks') %}
    <aside class="cb-add-section-tray" aria-label="{{ trayLabel }}">
        <p class="cb-add-section-tray__label">{{ trayLabel }}</p>
        <div class="cb-add-section-tray__buttons">
            {% for layout in cb_section_layouts() %}
                {% set layoutLabel = layout.label|trans({}, 'content_blocks') %}
                <button type="button"
                        class="cb-add-section-tray__btn"
                        data-cb-add-section="{{ layout.name }}"
                        aria-label="{{ layoutLabel }}"
                        title="{{ layoutLabel }}">
                    {{ include('@ContentBlocks/builder/section_layout_icon.html.twig', { layout: layout }, with_context = false) }}
                </button>
            {% endfor %}
        </div>
        <button type="button"
                class="cb-add-section-tray__library"
                data-cb-insert-template
                aria-label="{{ 'cb.builder.template.insert'|trans({}, 'content_blocks') }}"
                title="{{ 'cb.builder.template.insert'|trans({}, 'content_blocks') }}">
            <span aria-hidden="true">▤</span>
            {{ 'cb.builder.template.insert'|trans({}, 'content_blocks') }}
        </button>
    </aside>
    <script>window.__cbBlockTypes = {{ blockTypes|json_encode|raw }};</script>
    {# The overlay has no Stimulus element to hang `data-i18n-*` off, so its
       labels are translated here. Anything it hardcodes ships untranslated. #}
    <script>window.__cbOverlayLabels = {{ {
        add_block: 'cb.block.add_title'|trans({}, 'content_blocks'),
        add_section: 'cb.builder.add_section'|trans({}, 'content_blocks'),
        empty_cta: 'cb.builder.empty_cta'|trans({}, 'content_blocks'),
        block_drag: 'cb.block.drag'|trans({}, 'content_blocks'),
        block_duplicate: 'cb.block.duplicate'|trans({}, 'content_blocks'),
        block_delete: 'cb.block.remove'|trans({}, 'content_blocks'),
        section_drag: 'cb.section.drag'|trans({}, 'content_blocks'),
        section_move_up: 'cb.section.move_up'|trans({}, 'content_blocks'),
        section_move_down: 'cb.section.move_down'|trans({}, 'content_blocks'),
        section_duplicate: 'cb.section.duplicate'|trans({}, 'content_blocks'),
        section_save_template: 'cb.builder.template.save'|trans({}, 'content_blocks'),
        section_delete: 'cb.section.remove'|trans({}, 'content_blocks'),
    }|json_encode|raw }};</script>
    <script type="module" src="{{ path('content_blocks_asset_preview_overlay') }}"></script>
{% endif %}
</div>
