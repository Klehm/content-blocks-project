{# @var area \ContentBlocks\Entity\ContentArea #}
{# @var iframeUrl string #}
{# @var enableReplace bool #}
{# @var enableImportExport bool #}
{# @var topbarActions array #}
<div class="cb-shell"
     data-controller="cb-builder"
     data-cb-builder-area-id-value="{{ area.id }}"
     data-cb-builder-iframe-url-value="{{ iframeUrl }}"
     data-cb-csrf-token="{{ csrf_token('content_blocks') }}"
     data-i18n-cb-builder-discard-confirm="{{ 'cb.builder.discard_confirm'|trans({}, 'content_blocks') }}"
     {# On the shell root, not the library panel: this flow starts from the
        in-preview toolbar, whatever the sidebar shows. #}
     data-i18n-cb-builder-template-name-prompt="{{ 'cb.builder.template.name_prompt'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-template-delete-confirm="{{ 'cb.builder.template.delete_confirm'|trans({}, 'content_blocks') }}"
     {# Copy/paste is keyboard-only and its sole feedback is the snackbar,
        so every one of its messages is read from here. #}
     data-i18n-cb-builder-clipboard-section-copied="{{ 'cb.builder.clipboard.section_copied'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-block-copied="{{ 'cb.builder.clipboard.block_copied'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-nothing-selected="{{ 'cb.builder.clipboard.nothing_selected'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-empty="{{ 'cb.builder.clipboard.empty'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-no-target="{{ 'cb.builder.clipboard.no_target'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-stale-version="{{ 'cb.builder.clipboard.stale_version'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-unreadable="{{ 'cb.builder.clipboard.unreadable'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-skipped-blocks="{{ 'cb.builder.clipboard.skipped_blocks'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-clipboard-dropped-fields="{{ 'cb.builder.clipboard.dropped_fields'|trans({}, 'content_blocks') }}"
     {# Ctrl/Cmd-Z is keyboard-only too, so the snackbar carries every word
        it has to say. See docs/internals/history.md #}
     data-i18n-cb-builder-history-nothing-to-undo="{{ 'cb.builder.history.nothing_to_undo'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-history-nothing-to-redo="{{ 'cb.builder.history.nothing_to_redo'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-history-stale="{{ 'cb.builder.history.stale'|trans({}, 'content_blocks') }}"
     data-i18n-cb-builder-history-unavailable="{{ 'cb.builder.history.unavailable'|trans({}, 'content_blocks') }}">

    <div class="cb-shell__progress" data-cb-builder-target="progress" aria-hidden="true"></div>

    <header class="cb-shell__topbar">
        <div class="cb-shell__topbar-left">
            <button type="button"
                    class="cb-shell__close"
                    data-action="cb-builder#close"
                    aria-label="{{ 'cb.builder.close'|trans({}, 'content_blocks') }}">
                ×
            </button>
            {# One menu for everything area-wide, and skipped entirely when
               nothing would go in it. See docs/internals/frontend.md #}
            {% set hasReplace = enableReplace ?? true %}
            {% set hasImportExport = enableImportExport ?? true %}
            {% set actions = topbarActions|default([]) %}
            {% if hasReplace or hasImportExport or actions is not empty %}
                <div class="cb-shell__actions" data-cb-builder-target="actionsMenu">
                    <button type="button"
                            class="cb-shell__actions-toggle"
                            data-cb-builder-target="actionsToggle"
                            data-action="cb-builder#toggleActions"
                            aria-haspopup="menu"
                            aria-expanded="false">
                        <span class="cb-shell__btn-label">{{ 'cb.builder.actions'|trans({}, 'content_blocks') }}</span>
                        <span class="cb-shell__actions-caret" aria-hidden="true">▾</span>
                    </button>
                    <div class="cb-shell__actions-list"
                         data-cb-builder-target="actionsList"
                         role="menu"
                         hidden>
                        {% if hasReplace %}
                            <button type="button"
                                    class="cb-shell__actions-item cb-shell__replace"
                                    role="menuitem"
                                    data-action="cb-builder#openReplacePicker"
                                    aria-haspopup="dialog">
                                <span class="cb-shell__btn-icon" aria-hidden="true">⇆</span>
                                <span class="cb-shell__btn-label">{{ 'cb.builder.replace.open'|trans({}, 'content_blocks') }}</span>
                            </button>
                        {% endif %}
                        {% if hasImportExport %}
                            <button type="button"
                                    class="cb-shell__actions-item cb-shell__import-export"
                                    role="menuitem"
                                    data-action="cb-builder#openImportExport"
                                    aria-haspopup="dialog">
                                <span class="cb-shell__btn-icon" aria-hidden="true">⇅</span>
                                <span class="cb-shell__btn-label">{{ 'cb.builder.import_export.open'|trans({}, 'content_blocks') }}</span>
                            </button>
                        {% endif %}
                        {# Both sources are BuilderAction objects by here;
                           `icon|raw` is trusted code, never user input. #}
                        {% for action in actions %}
                            {% set actionTitle = (action.title ?? action.label)|trans %}
                            <button type="button"
                                    class="cb-shell__actions-item cb-shell__action cb-shell__action--{{ action.key }}"
                                    role="menuitem"
                                    data-action="cb-builder#runAction"
                                    data-cb-builder-action-key-param="{{ action.key }}"
                                    title="{{ actionTitle }}">
                                {% if action.icon %}
                                    <span class="cb-shell__btn-icon" aria-hidden="true">{{ action.icon|raw }}</span>
                                {% endif %}
                                <span class="cb-shell__btn-label">{{ action.label|trans }}</span>
                            </button>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {# Called here rather than passed in, so a host that includes the
               launcher directly still gets the right starting state. #}
            {% set history = cb_history_state(area) %}
            <div class="cb-shell__history" role="group"
                 aria-label="{{ 'cb.builder.history.group'|trans({}, 'content_blocks') }}">
                <button type="button"
                        class="cb-shell__history-btn cb-shell__history-btn--undo"
                        data-action="cb-builder#undoLastAction"
                        title="{{ 'cb.builder.history.undo'|trans({}, 'content_blocks') }} — Ctrl+Z"
                        aria-label="{{ 'cb.builder.history.undo'|trans({}, 'content_blocks') }}"
                        {% if not history.canUndo %}disabled{% endif %}>↶</button>
                <button type="button"
                        class="cb-shell__history-btn cb-shell__history-btn--redo"
                        data-action="cb-builder#redoLastAction"
                        title="{{ 'cb.builder.history.redo'|trans({}, 'content_blocks') }} — Ctrl+Shift+Z"
                        aria-label="{{ 'cb.builder.history.redo'|trans({}, 'content_blocks') }}"
                        {% if not history.canRedo %}disabled{% endif %}>↷</button>
            </div>
        </div>

        <div class="cb-shell__topbar-right">
            {# The panel it drives lives beside <main>, not here: floating
               over the preview needs the shell as containing block. #}
            <button type="button"
                    class="cb-shell__tree-toggle"
                    data-action="cb-builder#toggleTree"
                    aria-haspopup="dialog"
                    aria-expanded="false">
                <span class="cb-shell__btn-icon" aria-hidden="true">☰</span>
                <span class="cb-shell__btn-label">{{ 'cb.builder.tree.open'|trans({}, 'content_blocks') }}</span>
            </button>
            {# Right cluster, not centred: the canvas is offset by the
               sidebar, so a centred switcher never lined up with it. #}
            <div class="cb-shell__viewport" role="group">
                <button type="button"
                        class="cb-shell__viewport-btn cb-shell__viewport-btn--active"
                        data-action="cb-builder#setViewport"
                        data-cb-builder-viewport-param="desktop"
                        title="Desktop">▭</button>
                <button type="button"
                        class="cb-shell__viewport-btn"
                        data-action="cb-builder#setViewport"
                        data-cb-builder-viewport-param="tablet"
                        title="Tablet">▢</button>
                <button type="button"
                        class="cb-shell__viewport-btn"
                        data-action="cb-builder#setViewport"
                        data-cb-builder-viewport-param="mobile"
                        title="Mobile">▯</button>
            </div>

            {# Persistent until a later save succeeds: the editor must know
               their latest edits are not stored. #}
            <span class="cb-shell__save-error"
                  data-cb-builder-target="saveError"
                  role="alert"
                  hidden>
                <span class="cb-shell__btn-icon" aria-hidden="true">⚠</span>
                <span>{{ 'cb.builder.save_error'|trans({}, 'content_blocks') }}</span>
            </span>
            <button type="button"
                    class="cb-shell__discard"
                    data-action="cb-builder#discard"
                    title="{{ 'cb.builder.discard'|trans({}, 'content_blocks') }}"
                    aria-label="{{ 'cb.builder.discard'|trans({}, 'content_blocks') }}"
                    {% if not area.hasUnpublishedChanges %}hidden{% endif %}>
                <span class="cb-shell__btn-icon" aria-hidden="true">↶</span>
                <span class="cb-shell__btn-label">{{ 'cb.builder.discard'|trans({}, 'content_blocks') }}</span>
            </button>
            <button type="button"
                    class="cb-shell__publish"
                    data-action="cb-builder#publish"
                    {% if not area.hasUnpublishedChanges %}disabled{% endif %}>
                {{ 'cb.builder.publish'|trans({}, 'content_blocks') }}
            </button>
        </div>
    </header>

    {# One node for all three, so the dimming cannot stack or be orphaned by
       a picker that forgot to clean up. #}
    <div class="cb-modal-backdrop" hidden></div>

    {# Hidden until the topbar button is clicked, and skipped entirely when
       the feature is off. #}
    {% if enableReplace ?? true %}
    <div class="cb-replace-picker"
         data-cb-builder-target="replacePicker"
         role="dialog"
         aria-label="{{ 'cb.builder.replace.title'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-replace-loading="{{ 'cb.builder.replace.loading'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-replace-empty="{{ 'cb.builder.replace.empty'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-replace-empty-filtered="{{ 'cb.builder.replace.empty_filtered'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-replace-error="{{ 'cb.builder.replace.error'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-replace-confirm="{{ 'cb.builder.replace.confirm'|trans({}, 'content_blocks') }}"
         hidden>
        <header class="cb-replace-picker__header">
            <h3 class="cb-replace-picker__title">{{ 'cb.builder.replace.title'|trans({}, 'content_blocks') }}</h3>
            <button type="button"
                    class="cb-replace-picker__close"
                    data-action="cb-builder#closeReplacePicker"
                    aria-label="{{ 'cb.builder.close'|trans({}, 'content_blocks') }}">×</button>
        </header>
        <div class="cb-replace-picker__body">
            <input type="search"
                   class="cb-replace-picker__search"
                   data-cb-builder-target="replacePickerSearch"
                   data-action="input->cb-builder#onReplacePickerSearch"
                   placeholder="{{ 'cb.builder.replace.search_placeholder'|trans({}, 'content_blocks') }}"
                   autocomplete="off">
            <ul class="cb-replace-picker__list"
                data-cb-builder-target="replacePickerList"
                role="listbox"></ul>
            <p class="cb-replace-picker__status"
               data-cb-builder-target="replacePickerStatus"
               role="status"
               aria-live="polite"></p>
        </div>
    </div>
    {% endif %}

    {# The section library is no longer a modal here: it lives in the empty
       sidebar, where an editor with nothing selected is already looking. #}

    {# Same positioning rules as the replace picker, so the two overlays
       read as siblings. Skipped when the feature is off. #}
    {% if enableImportExport ?? true %}
    <div class="cb-import-export-picker"
         data-cb-builder-target="importExportPicker"
         role="dialog"
         aria-label="{{ 'cb.builder.import_export.title'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-confirm="{{ 'cb.builder.import_export.confirm'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-no-file="{{ 'cb.builder.import_export.no_file'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-importing="{{ 'cb.builder.import_export.importing'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-error="{{ 'cb.builder.import_export.error'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-skipped-blocks="{{ 'cb.builder.import_export.skipped_blocks'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-import-export-unknown-fields="{{ 'cb.builder.import_export.unknown_fields'|trans({}, 'content_blocks') }}"
         hidden>
        <header class="cb-import-export-picker__header">
            <h3 class="cb-import-export-picker__title">{{ 'cb.builder.import_export.title'|trans({}, 'content_blocks') }}</h3>
            <button type="button"
                    class="cb-import-export-picker__close"
                    data-action="cb-builder#closeImportExport"
                    aria-label="{{ 'cb.builder.close'|trans({}, 'content_blocks') }}">×</button>
        </header>
        <div class="cb-import-export-picker__body">
            <section class="cb-import-export-picker__section">
                <h4 class="cb-import-export-picker__heading">{{ 'cb.builder.import_export.export_heading'|trans({}, 'content_blocks') }}</h4>
                <p class="cb-import-export-picker__hint">{{ 'cb.builder.import_export.export_hint'|trans({}, 'content_blocks') }}</p>
                <button type="button"
                        class="cb-import-export-picker__btn cb-import-export-picker__btn--primary"
                        data-action="cb-builder#runExport">
                    {{ 'cb.builder.import_export.export_action'|trans({}, 'content_blocks') }}
                </button>
            </section>
            <div class="cb-import-export-picker__separator" aria-hidden="true"></div>
            <section class="cb-import-export-picker__section">
                <h4 class="cb-import-export-picker__heading">{{ 'cb.builder.import_export.import_heading'|trans({}, 'content_blocks') }}</h4>
                <p class="cb-import-export-picker__hint cb-import-export-picker__hint--warning">{{ 'cb.builder.import_export.import_hint'|trans({}, 'content_blocks') }}</p>
                <input type="file"
                       class="cb-import-export-picker__file"
                       data-cb-builder-target="importFile"
                       accept="application/json,.json">
                <button type="button"
                        class="cb-import-export-picker__btn cb-import-export-picker__btn--primary"
                        data-action="cb-builder#runImport">
                    {{ 'cb.builder.import_export.import_action'|trans({}, 'content_blocks') }}
                </button>
                <p class="cb-import-export-picker__status"
                   data-cb-builder-target="importExportStatus"
                   role="status"
                   aria-live="polite"></p>
            </section>
        </div>
    </div>
    {% endif %}

    {# The sidebar is permanent: it always occupies its column and only its
       content swaps. See docs/internals/frontend.md #}
    <main class="cb-shell__main">
        <aside data-cb-builder-target="sidebar"
               class="cb-shell__sidebar"
               aria-label="{{ 'cb.block.edit'|trans({}, 'content_blocks') }}">
            <span class="cb-shell__sidebar-saved"
                  data-cb-builder-target="savedFlash"
                  role="status"
                  aria-live="polite"
                  hidden>✓ {{ 'cb.builder.saved'|trans({}, 'content_blocks') }}</span>
            <div class="cb-shell__sidebar-content" data-cb-builder-target="sidebarContent">
                {% include '@ContentBlocks/builder/sidebar_empty.html.twig' %}
            </div>
            {# Overhangs the iframe, so it stays clickable in both the
               expanded and the collapsed state. #}
            <button type="button"
                    class="cb-shell__sidebar-toggle"
                    data-cb-builder-target="sidebarToggle"
                    data-action="cb-builder#toggleSidebar"
                    aria-label="{{ 'cb.builder.toggle_sidebar'|trans({}, 'content_blocks') }}"
                    aria-expanded="true">
                <span class="cb-shell__sidebar-toggle-icon" aria-hidden="true">‹</span>
            </button>
            <div class="cb-shell__sidebar-resize"
                 data-cb-builder-target="sidebarResize"
                 data-action="mousedown->cb-builder#startSidebarResize touchstart->cb-builder#startSidebarResize"
                 aria-hidden="true"></div>
        </aside>
        <iframe data-cb-builder-target="iframe"
                class="cb-shell__iframe"
                title="{{ 'cb.builder.preview'|trans({}, 'content_blocks') }}"></iframe>
    </main>

    {# Floats over the preview, so it sits where the undo snackbar does —
       absolute against the shell, not inside a topbar 56px tall. #}
    <div class="cb-tree"
         data-controller="cb-tree"
         data-cb-tree-area-id-value="{{ area.id }}"
         role="dialog"
         aria-label="{{ 'cb.builder.tree.title'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-empty="{{ 'cb.builder.tree.empty'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-loading="{{ 'cb.builder.tree.loading'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-error="{{ 'cb.builder.tree.error'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-duplicate="{{ 'cb.builder.tree.duplicate'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-delete="{{ 'cb.builder.tree.delete'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-drag="{{ 'cb.builder.tree.drag'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-collapse="{{ 'cb.builder.tree.collapse'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-tree-expand="{{ 'cb.builder.tree.expand'|trans({}, 'content_blocks') }}"
         hidden>
        {# The header is the drag handle: a panel that floats over the content
           it describes has to be movable off whatever it is hiding. #}
        <header class="cb-tree__header"
                data-cb-tree-target="handle"
                data-action="pointerdown->cb-tree#startDrag"
                title="{{ 'cb.builder.tree.move'|trans({}, 'content_blocks') }}">
            <h3 class="cb-tree__title">{{ 'cb.builder.tree.title'|trans({}, 'content_blocks') }}</h3>
            <button type="button"
                    class="cb-tree__close"
                    data-action="cb-tree#close"
                    aria-label="{{ 'cb.builder.tree.close'|trans({}, 'content_blocks') }}">×</button>
        </header>
        <div class="cb-tree__body">
            <ul class="cb-tree__list" data-cb-tree-target="list"></ul>
            <p class="cb-tree__status"
               data-cb-tree-target="status"
               role="status"
               aria-live="polite"></p>
        </div>
    </div>

    {# Two uses, one element: the undo offer, and the acknowledgement a copy
       needs since it changes nothing on screen. #}
    <div class="cb-shell__undo"
         data-cb-builder-target="undoBar"
         data-cb-builder-undo-block-deleted="{{ 'cb.builder.undo.block_deleted'|trans({}, 'content_blocks') }}"
         data-cb-builder-undo-section-deleted="{{ 'cb.builder.undo.section_deleted'|trans({}, 'content_blocks') }}"
         role="status"
         aria-live="polite"
         hidden>
        <span class="cb-shell__undo-label" data-cb-builder-target="undoLabel"></span>
        <button type="button"
                class="cb-shell__undo-btn"
                data-cb-builder-target="undoButton"
                data-action="cb-builder#undoDelete">
            {{ 'cb.builder.undo.action'|trans({}, 'content_blocks') }}
        </button>
    </div>

    {# Last, so a fragment's overlay stacks above the chrome, and inside the
       shell so its script can reach the token and the area id. #}

    {# Rendered in isolation: a fragment sees its own context plus `area`,
       never the shell's. See docs/internals/builder-extensions.md #}
    {% for fragment in cb_shell_fragments(area) %}
        {{ include(fragment.template, fragment.context|merge({ area: area }), with_context = false) }}
    {% endfor %}
</div>
