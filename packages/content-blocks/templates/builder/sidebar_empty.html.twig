{# The sidebar with nothing focused: a hint, the section layouts, and the
   saved-section library. #}

{# The library is here rather than behind a modal — it is the panel's whole
   reason to exist when nothing is selected. #}
<div class="cb-sidebar-empty">
    <p class="cb-sidebar-empty__hint">
        {{ 'cb.builder.sidebar.empty'|trans({}, 'content_blocks') }}
    </p>
    <div class="cb-sidebar-empty__sections">
        <p class="cb-sidebar-empty__sections-label">
            {{ 'cb.builder.add_section'|trans({}, 'content_blocks') }}
        </p>
        <div class="cb-sidebar-empty__buttons">
            {% for layout in cb_section_layouts() %}
                {% set label = layout.label|trans({}, 'content_blocks') %}
                <button type="button"
                        class="cb-sidebar-empty__btn"
                        data-action="cb-builder#addSection"
                        data-cb-builder-layout-param="{{ layout.name }}"
                        aria-label="{{ label }}"
                        title="{{ label }}">
                    {{ include('@ContentBlocks/builder/section_layout_icon.html.twig', { layout: layout }, with_context = false) }}
                </button>
            {% endfor %}
        </div>
    </div>

    <div class="cb-sidebar-library cb-template-picker"
         data-cb-builder-target="templatePicker"
         data-i18n-cb-builder-template-loading="{{ 'cb.builder.template.loading'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-empty="{{ 'cb.builder.template.empty'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-empty-filtered="{{ 'cb.builder.template.empty_filtered'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-error="{{ 'cb.builder.template.error'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-load-more="{{ 'cb.builder.template.load_more'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-incompatible="{{ 'cb.builder.template.incompatible'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-unreadable-format="{{ 'cb.builder.template.unreadable_format'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-stale-version="{{ 'cb.builder.template.stale_version'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-partial="{{ 'cb.builder.template.partial'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-skipped-blocks="{{ 'cb.builder.template.skipped_blocks'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-warnings="{{ 'cb.builder.template.warnings'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-name-prompt="{{ 'cb.builder.template.name_prompt'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-delete="{{ 'cb.builder.template.delete'|trans({}, 'content_blocks') }}"
         data-i18n-cb-builder-template-delete-confirm="{{ 'cb.builder.template.delete_confirm'|trans({}, 'content_blocks') }}">
        <p class="cb-sidebar-library__label">
            {{ 'cb.builder.template.title'|trans({}, 'content_blocks') }}
        </p>
        <input type="search"
               class="cb-template-picker__search"
               data-cb-builder-target="templatePickerSearch"
               data-action="input->cb-builder#onTemplatePickerSearch"
               placeholder="{{ 'cb.builder.template.search_placeholder'|trans({}, 'content_blocks') }}"
               autocomplete="off">
        <ul class="cb-template-picker__list"
            data-cb-builder-target="templatePickerList"
            role="listbox"></ul>
        <p class="cb-template-picker__status"
           data-cb-builder-target="templatePickerStatus"
           role="status"
           aria-live="polite"></p>
    </div>
</div>
