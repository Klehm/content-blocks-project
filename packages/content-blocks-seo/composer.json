{
    "name": "klehm/content-blocks-seo",
    "description": "On-page SEO audit for ContentBlocks — heading outline, alt text, link text and paragraph length, checked on the draft page from the builder.",
    "keywords": [
        "content-blocks",
        "seo",
        "audit",
        "accessibility",
        "page-builder",
        "symfony",
        "symfony-bundle"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/klehm/content-blocks-project",
    "support": {
        "issues": "https://github.com/klehm/content-blocks-project/issues",
        "source": "https://github.com/klehm/content-blocks-seo"
    },
    "authors": [
        {
            "name": "Clément Muller",
            "email": "klehm.muller@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "klehm/content-blocks": "^1.5",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "ContentBlocks\\Seo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentBlocks\\Seo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "ContentBlocks\\Seo\\ContentBlocksSeoBundle"
        },
        "branch-alias": {
            "dev-master": "1.6.x-dev",
            "dev-main": "1.6.x-dev"
        }
    },
    "repositories": {
        "core": {
            "type": "path",
            "url": "../content-blocks"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
