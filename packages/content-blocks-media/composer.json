{
    "name": "klehm/content-blocks-media",
    "description": "Media library for ContentBlocks: pick a file already uploaded, with folders, alt text and the pages that use it.",
    "keywords": [
        "content-blocks",
        "media",
        "media-library",
        "page-builder",
        "symfony",
        "symfony-bundle"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/klehm/content-blocks-project",
    "support": {
        "issues": "https://github.com/klehm/content-blocks-project/issues",
        "source": "https://github.com/klehm/content-blocks-media"
    },
    "authors": [
        {
            "name": "Clément Muller",
            "email": "klehm.muller@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^3.6 || ^4.0",
        "doctrine/doctrine-bundle": "^2.10 || ^3.0",
        "doctrine/orm": "^2.15 || ^3.0",
        "klehm/content-blocks": "^1.5",
        "psr/log": "^2.0 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/routing": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^3.27"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "ContentBlocks\\Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentBlocks\\Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "ContentBlocks\\Media\\ContentBlocksMediaBundle"
        },
        "branch-alias": {
            "dev-master": "1.5.x-dev",
            "dev-main": "1.5.x-dev"
        }
    },
    "repositories": {
        "core": {
            "type": "path",
            "url": "../content-blocks"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
