{# The media picker: a <dialog> answering `cb:media:browse`. Self-contained:
   its URLs and token are its own, so the i18n workbench can render it too. #}
{% trans_default_domain 'content_blocks_media' %}
<link rel="stylesheet" href="{{ path('content_blocks_media_asset', {type: 'css', v: assetVersions.css}) }}">
<dialog class="cb-media" data-cb-media
        aria-labelledby="cb-media-title-{{ area.id }}"
        data-area="{{ area.id }}"
        data-kinds="{{ kinds|json_encode }}"
        data-can-manage="{{ canManage ? '1' : '0' }}"
        data-csrf-token="{{ csrf_token('content_blocks') }}"
        data-urls="{{ {
            list: path('content_blocks_media_list'),
            place: path('content_blocks_media_place'),
            upload: path('content_blocks_upload'),
            folders: path('content_blocks_media_folders'),
            folderCreate: path('content_blocks_media_folder_create'),
            folderRename: path('content_blocks_media_folder_rename'),
            folderDelete: path('content_blocks_media_folder_delete'),
            fileUpdate: path('content_blocks_media_file_update'),
            fileMove: path('content_blocks_media_file_move'),
            fileRemove: path('content_blocks_media_file_remove'),
            fileUsage: path('content_blocks_media_file_usage'),
        }|json_encode }}"
        data-i18n="{{ {
            image: 'cb_media.picker.title_image'|trans,
            video: 'cb_media.picker.title_video'|trans,
            empty: 'cb_media.picker.empty'|trans,
            no_match: 'cb_media.picker.no_match'|trans,
            loading: 'cb_media.picker.loading'|trans,
            failed: 'cb_media.picker.failed'|trans,
            uploading: 'cb_media.picker.uploading'|trans,
            upload_failed: 'cb_media.picker.upload_failed'|trans,
            save_failed: 'cb_media.manage.save_failed'|trans,
            root: 'cb_media.picker.root'|trans,
            folder_name: 'cb_media.manage.folder_name'|trans,
            rename_folder: 'cb_media.manage.rename_folder'|trans,
            delete_folder: 'cb_media.manage.delete_folder'|trans,
            delete_folder_confirm: 'cb_media.manage.delete_folder_confirm'|trans,
            remove_confirm: 'cb_media.manage.remove_confirm'|trans,
            remove_confirm_used: 'cb_media.manage.remove_confirm_used'|trans,
            unused: 'cb_media.manage.unused'|trans,
            draft: 'cb_media.manage.draft'|trans,
            others: 'cb_media.manage.others'|trans,
            selected_many: 'cb_media.manage.selected_many'|trans,
            remove_confirm_many: 'cb_media.manage.remove_confirm_many'|trans,
            move_to: 'cb_media.manage.move_to'|trans,
        }|json_encode }}">
    <form method="dialog" class="cb-media__frame">
        <header class="cb-media__header">
            <h2 class="cb-media__title" id="cb-media-title-{{ area.id }}" data-cb-media-title></h2>
            <input type="search" class="cb-media__search" data-cb-media-search
                   placeholder="{{ 'cb_media.picker.search'|trans }}"
                   aria-label="{{ 'cb_media.picker.search'|trans }}">
            <button type="submit" value="cancel" class="cb-media__close"
                    aria-label="{{ 'cb_media.picker.close'|trans }}"
                    title="{{ 'cb_media.picker.close'|trans }}">×</button>
        </header>

        <div class="cb-media__bar">
            <nav class="cb-media__trail" data-cb-media-trail aria-label="{{ 'cb_media.picker.folders'|trans }}"></nav>
            {% if canManage %}
                <button type="button" class="cb-media__link" data-cb-media-new-folder>{{ 'cb_media.manage.new_folder'|trans }}</button>
            {% endif %}
        </div>

        <div class="cb-media__body">
            <div class="cb-media__main" data-cb-media-main>
                <ul class="cb-media__folders" data-cb-media-folders></ul>
                <ul class="cb-media__grid" data-cb-media-grid
                    aria-label="{{ 'cb_media.picker.files'|trans }}"></ul>
                <p class="cb-media__status" data-cb-media-status role="status" aria-live="polite"></p>
                <button type="button" class="cb-media__btn cb-media__more" data-cb-media-more hidden>{{ 'cb_media.picker.more'|trans }}</button>
            </div>

            <aside class="cb-media__detail" data-cb-media-detail hidden>
                <div class="cb-media__preview" data-cb-media-preview></div>
                <p class="cb-media__facts" data-cb-media-facts></p>
                <label class="cb-media__field cb-media__field--single">
                    <span>{{ 'cb_media.manage.title'|trans }}</span>
                    <input type="text" maxlength="255" data-cb-media-field="title" {{ canManage ? '' : 'readonly' }}>
                </label>
                <label class="cb-media__field cb-media__field--single">
                    <span>{{ 'cb_media.manage.alt'|trans }}</span>
                    <textarea rows="3" maxlength="255" data-cb-media-field="alt" {{ canManage ? '' : 'readonly' }}></textarea>
                </label>
                {% if canManage %}
                    <label class="cb-media__field">
                        <span>{{ 'cb_media.manage.folder'|trans }}</span>
                        <select data-cb-media-move></select>
                    </label>
                {% endif %}
                <div class="cb-media__usage">
                    <span>{{ 'cb_media.manage.used_on'|trans }}</span>
                    <ul data-cb-media-usage></ul>
                </div>
                {% if canManage %}
                    <button type="button" class="cb-media__link cb-media__link--danger" data-cb-media-remove>{{ 'cb_media.manage.remove'|trans }}</button>
                {% endif %}
            </aside>
        </div>

        <footer class="cb-media__footer">
            <label class="cb-media__btn">
                {{ 'cb_media.picker.upload'|trans }}
                <input type="file" class="cb-media__file" data-cb-media-file multiple>
            </label>
            <p class="cb-media__selection" data-cb-media-selection></p>
            <button type="button" class="cb-media__btn cb-media__btn--primary" data-cb-media-insert disabled>{{ 'cb_media.picker.insert'|trans }}</button>
        </footer>
    </form>
</dialog>
<script type="module" src="{{ path('content_blocks_media_asset', {type: 'js', v: assetVersions.js}) }}"></script>
