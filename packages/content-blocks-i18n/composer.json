{
    "name": "klehm/content-blocks-i18n",
    "description": "Content translation for ContentBlocks — one shared layout, per-locale field values, translation progress and pluggable machine translation.",
    "keywords": [
        "content-blocks",
        "i18n",
        "translation",
        "multilingual",
        "page-builder",
        "symfony",
        "symfony-bundle"
    ],
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/klehm/content-blocks-project",
    "support": {
        "issues": "https://github.com/klehm/content-blocks-project/issues",
        "source": "https://github.com/klehm/content-blocks-i18n"
    },
    "authors": [
        {
            "name": "Clément Muller",
            "email": "klehm.muller@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "klehm/content-blocks": "^1.0",
        "doctrine/dbal": "^3.6 || ^4.0",
        "doctrine/orm": "^2.15 || ^3.0",
        "doctrine/doctrine-bundle": "^2.10 || ^3.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/form": "^6.4 || ^7.0 || ^8.0",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-csrf": "^6.4 || ^7.0 || ^8.0",
        "symfony/translation": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ContentBlocks\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ContentBlocks\\I18n\\Tests\\": "tests/"
        }
    },
    "extra": {
        "symfony": {
            "bundle": "ContentBlocks\\I18n\\ContentBlocksI18nBundle"
        },
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "core": {
            "type": "path",
            "url": "../content-blocks"
        }
    }
}
