includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 8
    paths:
        - packages/content-blocks/src
        - packages/content-blocks-kit/src
        - packages/content-blocks-i18n/src
        - packages/content-blocks-media/src
        - packages/content-blocks-seo/src
        - packages/content-blocks-sylius/src

    # Block data is free-form JSON of unknown age, read defensively on purpose.
    # A declared type is what the writer promised, not what the row holds, so a
    # guard PHPStan calls redundant is often the one that survives real data.
    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # An owning-side association is nullable in PHP because the entity
        # exists before it is attached, while the FK stays NOT NULL. Making
        # either side agree would break the other.
        -
            identifier: doctrine.associationType
            message: '#type mapping mismatch: property can contain .* but database expects#'
        # The same gap on a column of an entity filled by a Sylius admin form:
        # CodeAwareInterface reads "no code yet" as null, the column is NOT NULL.
        -
            identifier: doctrine.columnType
            message: '#type mapping mismatch: property can contain .*\|null but database expects#'
            path: packages/content-blocks-sylius/src/Entity/*
