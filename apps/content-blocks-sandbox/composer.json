{
    "name": "klehm/content-blocks-sandbox",
    "description": "Application Symfony de test pour les bundles ContentBlocks.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "klehm/content-blocks": "@dev",
        "klehm/content-blocks-kit": "@dev",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.2",
        "symfony/asset-mapper": "^7.0 || ^8.0",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/dotenv": "^7.0 || ^8.0",
        "symfony/flex": "^2.4",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/runtime": "^7.0 || ^8.0",
        "symfony/stimulus-bundle": "^2.0 || ^3.0",
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "symfony/ux-live-component": "^2.0 || ^3.0",
        "symfony/ux-twig-component": "^2.0 || ^3.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "twig/twig": "^3.10",
        "symfony/translation": "^7.4 || ^8.0",
        "symfony/mime": "^7.4 || ^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../packages/content-blocks",
            "options": { "symlink": true }
        },
        {
            "type": "path",
            "url": "../../packages/content-blocks-kit",
            "options": { "symlink": true }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
