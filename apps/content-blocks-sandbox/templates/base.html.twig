<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}ContentBlocks Sandbox{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    <style>
        .cb-page-builder { max-width: 960px; margin: 2rem auto; }
        .cb-section { border: 2px dashed #dee2e6; border-radius: .5rem; padding: 1rem; margin-bottom: 1rem; }
        .cb-section__toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: .5rem; }
        .cb-column { min-height: 80px; border: 1px solid #e9ecef; border-radius: .25rem; padding: .5rem; }
        .cb-dragging { opacity: 0.4; }
        .cb-page-builder__add-section { text-align: center; padding: 1rem; }
        .cb-block__handle { cursor: grab; }
        .cb-block__handle:active { cursor: grabbing; }
        .cb-section__handle:active { cursor: grabbing; }
        .cb-drop-after { border-bottom: 3px solid #0d6efd !important; }
        .cb-column__blocks[data-cb-block-drop-target] { min-height: 50px; }
        .cb-dragging { opacity: 0.4; }
        .cb-drop-before { border-top: 3px solid #0d6efd !important; }
        .cb-drop-inside { background-color: rgba(13, 110, 253, 0.1); outline: 2px dashed #0d6efd; outline-offset: -2px; }
    </style>
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">ContentBlocks Sandbox</a>
        </div>
    </nav>

    <div class="container">
        {% block body %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
