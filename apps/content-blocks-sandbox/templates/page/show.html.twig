<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }}</title>
    <style>
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: #1f2330;
        }
        article {
            max-width: 1100px;
            margin: 0 auto;
            padding: 2rem 1.5rem;
        }
    </style>
    {# Kit blocks ship their own self-contained stylesheet, and this template
       does not extend base.html.twig — so it has to link it itself. This page
       is also what the builder loads in its preview iframe: without this, every
       kit block renders unstyled there (most visibly, a preset-width image
       ignores its `max-width: 100%` and bursts out of its column). #}
    <link rel="stylesheet" href="{{ path('content_blocks_kit_asset_css') }}">
</head>
<body>
    <article>
        <h1>{{ page.title }}</h1>
        {% if page.contentArea %}
            {{ cb_render_content_area(page.contentArea) }}
        {% endif %}
    </article>
</body>
</html>
