{% extends 'base.html.twig' %}

{% block title %}Builder — {{ page.title }}{% endblock %}

{% block body %}
    <a href="/" class="btn btn-outline-secondary btn-sm mb-3">&larr; Back</a>
    <h1 class="mb-3">{{ page.title }}</h1>

    {% if page.contentArea %}
        {% include '@ContentBlocks/builder/launcher.html.twig' with {
            area: page.contentArea,
            iframeUrl: cb_preview_url(page.contentArea),
        } only %}
    {% else %}
        <p class="text-muted">ContentArea not available.</p>
    {% endif %}
{% endblock %}
