{#
    Demo marketing-site chrome used by the public page render and the model
    preview. Header + footer simulate a real site so the ContentBlocks content
    reads as page content rather than an isolated fragment.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Nova{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --nova: #4f8df9; }
        body { display: flex; flex-direction: column; min-height: 100vh; }
        .nova-brand { font-weight: 700; letter-spacing: -0.02em; }
        .nova-brand .dot { color: var(--nova); }
        .nova-header { border-bottom: 1px solid #eef0f3; }
        .nova-nav .nav-link { color: #3a4051; font-weight: 500; }
        .nova-nav .nav-link:hover { color: var(--nova); }
        main { flex: 1 0 auto; }
        .nova-footer { background: #0f1320; color: #c7ccd8; }
        .nova-footer a { color: #c7ccd8; text-decoration: none; }
        .nova-footer a:hover { color: #fff; }
        .nova-footer h6 { color: #fff; }
    </style>
    {# Kit blocks ship their own self-contained stylesheet. #}
    <link rel="stylesheet" href="{{ path('content_blocks_kit_asset_css') }}">
    {% block head '' %}
</head>
<body>
    <header class="nova-header bg-white">
        <nav class="navbar navbar-expand-lg container py-3">
            <a class="navbar-brand nova-brand" href="#">Nova<span class="dot">.</span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#novaNav" aria-label="Menu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse nova-nav" id="novaNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="#">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Fonctionnalités</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Tarifs</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Blog</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Contact</a></li>
                </ul>
                <a class="btn btn-primary" href="#" style="--bs-btn-bg: var(--nova); --bs-btn-border-color: var(--nova);">Essai gratuit</a>
            </div>
        </nav>
    </header>

    <main>
        {% block content %}{% endblock %}
    </main>

    <footer class="nova-footer mt-5 py-5">
        <div class="container">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <div class="nova-brand fs-4 text-white mb-2">Nova<span class="dot">.</span></div>
                    <p class="small mb-0">La plateforme qui fait grandir votre activité. Ceci est un site de démonstration.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Produit</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="#">Fonctionnalités</a></li>
                        <li><a href="#">Tarifs</a></li>
                        <li><a href="#">Intégrations</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Entreprise</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="#">À propos</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Carrières</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Ressources</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="#">Documentation</a></li>
                        <li><a href="#">Support</a></li>
                        <li><a href="#">Statut</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="mb-3">Légal</h6>
                    <ul class="list-unstyled small d-grid gap-2">
                        <li><a href="#">Confidentialité</a></li>
                        <li><a href="#">CGU</a></li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary my-4">
            <p class="small mb-0">© {{ 'now'|date('Y') }} Nova. Tous droits réservés.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
