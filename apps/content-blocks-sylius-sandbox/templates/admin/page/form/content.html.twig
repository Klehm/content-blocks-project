{% set form = hookable_metadata.context.form %}
{% set resource = hookable_metadata.context.resource|default(null) %}

<div class="container-xl">
    <div class="row">
        <div class="col-md-8">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#tab-general" role="tab">
                        Général
                    </a>
                </li>
                {% if resource and resource.contentArea %}
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#tab-builder" role="tab">
                        Constructeur
                    </a>
                </li>
                {% endif %}
            </ul>

            <div class="tab-content">
                <div class="tab-pane show active" id="tab-general" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-body">
                            {{ form_row(form.title) }}
                            {{ form_row(form.slug) }}
                        </div>
                    </div>
                </div>

                {% if resource and resource.contentArea %}
                <div class="tab-pane" id="tab-builder" role="tabpanel">
                    <div class="card mb-3">
                        <div class="card-body">
                            {# Host-wired builder topbar action: the button
                               dispatches the generic `cb:builder:action` event,
                               which cb-host-actions picks up off `document`. #}
                            <div data-controller="cb-host-actions"
                                 data-cb-host-actions-save-as-model-url-value="{{ path('app_page_save_as_model', { id: resource.id }) }}">
                                {% include '@ContentBlocks/builder/launcher.html.twig' with {
                                    area: resource.contentArea,
                                    iframeUrl: cb_preview_url(resource.contentArea),
                                    topbarActions: [
                                        { key: 'save-as-model', label: 'Enregistrer comme modèle', icon: '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>', title: 'Enregistrer cette page comme modèle réutilisable' },
                                    ],
                                } only %}
                                <p data-cb-host-actions-target="status" hidden></p>
                            </div>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Publication</h3>
                </div>
                <div class="card-body">
                    {{ form_row(form.enabled) }}
                    {% if resource and resource.id %}
                        <a href="{{ path('app_page_show', { id: resource.id }) }}"
                           target="_blank" rel="noopener"
                           class="btn btn-outline-primary w-100 mt-2">
                            Voir la page publiée
                            {{ ux_icon('tabler:external-link', {class: 'ms-1'}) }}
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
