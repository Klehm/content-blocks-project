<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.title }}</title>
    <style>
        body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #1f2330; }
        article { max-width: 1100px; margin: 0 auto; padding: 2rem 1.5rem; }
    </style>
</head>
<body>
    <article>
        <h1>{{ page.title }}</h1>
        {% if page.contentArea %}
            {{ cb_render_content_area(page.contentArea) }}
        {% endif %}
    </article>
</body>
</html>
