{
    "manifests": {
        "klehm/content-blocks": {
            "manifest": {
                "bundles": {
                    "ContentBlocks\\ContentBlocksBundle": [
                        "all"
                    ]
                },
                "copy-from-recipe": {
                    "config/": "%CONFIG_DIR%/"
                },
                "post-install-output": [
                    "  <bg=blue;fg=white>                                </>",
                    "  <bg=blue;fg=white> ContentBlocks is almost ready! </>",
                    "  <bg=blue;fg=white>                                </>",
                    "",
                    "  * <fg=blue>Wire the two REQUIRED host services</> (the bundle is deny-all by default):",
                    "    <comment>AccessCheckerInterface</comment> and <comment>ContentAreaUrlResolverInterface</comment>,",
                    "    see <comment>config/packages/content_blocks.yaml</comment>.",
                    "",
                    "  * <fg=blue>Link a ContentArea to your entity</>:",
                    "    <comment>#[ORM\\OneToOne(targetEntity: ContentArea::class, cascade: ['persist', 'remove'])]</comment>",
                    "    then add <comment>->add('contentArea', ContentAreaType::class)</comment> to its form.",
                    "",
                    "  * <fg=blue>Update your database schema</>: <comment>php bin/console doctrine:migrations:diff</comment>",
                    "",
                    "  * If your admin firewall does not cover <comment>/_content-blocks</comment>, extend its",
                    "    pattern (<comment>^/(admin|_content-blocks)</comment>) or mount the builder routes under",
                    "    your admin prefix. Sessions and CSRF protection must be enabled.",
                    "",
                    "  * Full docs: <href=https://klehm.github.io/content-blocks-project/>klehm.github.io/content-blocks-project</>"
                ]
            },
            "files": {
                "config/packages/content_blocks.yaml": {
                    "contents": [
                        "# ContentBlocks \u2014 https://klehm.github.io/content-blocks-project/guide/installation",
                        "content_blocks:",
                        "    # Where uploaded images and files are stored. Remove `directory` (or set it",
                        "    # to null) and alias FileStorageInterface to use your own storage (S3, \u2026).",
                        "    upload:",
                        "        directory: '%kernel.project_dir%/public/uploads/content-blocks'",
                        "        public_prefix: '/uploads/content-blocks'",
                        "",
                        "# The bundle is secure by default and ships NO working implementation for",
                        "# these two services: the builder refuses every request and the preview throws",
                        "# until you wire them.",
                        "#",
                        "# services:",
                        "#     # REQUIRED \u2014 authorization: canEdit() guards every builder action.",
                        "#     ContentBlocks\\Security\\AccessCheckerInterface:",
                        "#         class: App\\Security\\PageAccessChecker",
                        "#",
                        "#     # REQUIRED \u2014 the public URL of the page owning a ContentArea (preview).",
                        "#     ContentBlocks\\Preview\\ContentAreaUrlResolverInterface:",
                        "#         class: App\\Preview\\PageContentAreaUrlResolver",
                        "#",
                        "#     # OPTIONAL \u2014 search and labels in the \"Insert content\" picker.",
                        "#     # ContentBlocks\\Replace\\ContentAreaProviderInterface:",
                        "#     #     class: App\\ContentBlocks\\PageContentAreaProvider",
                        ""
                    ],
                    "executable": false
                },
                "config/routes/content_blocks.yaml": {
                    "contents": [
                        "content_blocks:",
                        "    resource: '@ContentBlocksBundle/config/routes.php'",
                        ""
                    ],
                    "executable": false
                }
            },
            "ref": "421dce0014bb2d825301c40619562b12a553d40e"
        }
    }
}
